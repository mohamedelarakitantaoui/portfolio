{
  "name": "mamoun-portfolio-v2",
  "type": "module",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "node scripts/check.mjs",
    "check:copy": "node scripts/check-copy.mjs",
    "lint:css": "stylelint \"src/**/*.{css,astro}\"",
    "check:banned": "node scripts/check-banned.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:tokens": "node scripts/check-tokens.mjs",
    "check:media": "node scripts/check-media.mjs",
    "check:seo": "node scripts/check-seo.mjs",
    "check:links": "node scripts/check-links.mjs",
    "check:html": "html-validate \"dist/**/*.html\"",
    "check:cv": "node scripts/check-cv.mjs",
    "check:fast": "node scripts/check.mjs --fast",
    "check:visual": "node scripts/visual.mjs",
    "check:visual:update": "node scripts/visual.mjs --update",
    "check:perf": "node scripts/perf.mjs",
    "test:e2e": "playwright test --project=checks",
    "types": "astro check"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.0.2",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/dm-sans": "latest",
    "@fontsource-variable/jetbrains-mono": "latest",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "latest",
    "astro": "^7.3.5",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "satori": "latest",
    "sharp": "latest"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "1.63",
    "html-validate": "^11.16.2",
    "lint-staged": "^17.6.0",
    "pdfjs-dist": "^6.4.299",
    "playwright": "^1.63.0",
    "postcss-html": "^2.0.0",
    "simple-git-hooks": "^2.14.0",
    "stylelint": "^17.16.0",
    "stylelint-declaration-strict-value": "^1.12.1",
    "typescript": "^6.0.3"
  }
}
