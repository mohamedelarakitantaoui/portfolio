---
import { type Lang, lp, t } from '../i18n/ui';
import { person } from '../data/site';
import { cvLink } from '../lib/cv';
import { allProjects, projectHref } from '../lib/projects';
interface Props { lang: Lang; enPath: string; frPath: string }
const { lang, enPath, frPath } = Astro.props;
const cv = cvLink(lang);
// Every project page: case studies and short project pages.
const projects = await allProjects(lang);
const go = t(lang, 'palette.go');
const act = t(lang, 'palette.action');
const fr = lang === 'fr';
const items = [
  { kind: go, label: t(lang, 'nav.home'), href: lp(lang, '/'), keys: 'home accueil' },
  { kind: go, label: t(lang, 'nav.work'), href: lp(lang, '/work'), keys: 'work projects projets portfolio' },
  ...projects.map((p) => ({ kind: go, label: `${p.data.title} · ${t(lang, p.data.caseStudy ? 'cs.label' : 'proj.label')}`, href: projectHref(lang, p.data.key), keys: `${p.data.tags.join(' ')} ${p.data.stack.join(' ')} ${p.data.meta}` })),
  { kind: go, label: t(lang, 'nav.about'), href: lp(lang, '/about'), keys: 'about experience education propos' },
  { kind: go, label: t(lang, 'nav.services'), href: lp(lang, '/services'), keys: 'services freelance packs hire offres' },
  { kind: go, label: t(lang, 'nav.cv'), href: lp(lang, '/cv'), keys: 'cv resume curriculum' },
  { kind: go, label: t(lang, 'nav.creative'), href: lp(lang, '/creative'), keys: 'creative photo design créatif' },
  { kind: go, label: t(lang, 'nav.contact'), href: lp(lang, '/contact'), keys: 'contact email message' },
  { kind: act, label: t(lang, 'cta.copyEmail'), action: 'copy-email', keys: `email mail ${person.email}` },
  ...(cv.download ? [{ kind: act, label: t(lang, 'cta.downloadCv') + ' (PDF)', href: cv.href, download: true, keys: 'cv pdf resume download télécharger' }] : []),
  { kind: act, label: t(lang, 'lang.switch'), href: lang === 'en' ? frPath : enPath, keys: 'language langue french english français anglais fr en' },
  { kind: act, label: 'LinkedIn', href: person.linkedin, external: true, keys: 'linkedin profile profil' },
  { kind: act, label: 'GitHub', href: person.github, external: true, keys: 'github code repos' },
  { kind: act, label: fr ? 'Interroger le terminal ask-mamoun' : 'Ask the ask-mamoun terminal', action: 'ask', keys: 'ask terminal question search demander' },
];
---
<dialog class="palette" id="palette" aria-labelledby="palette-title" data-lenis-prevent>
  <div class="palette__box">
    <h2 class="sr-only" id="palette-title">{t(lang, 'palette.title')}</h2>
    <label class="sr-only" for="palette-input">{t(lang, 'palette.placeholder')}</label>
    <input
      id="palette-input" class="palette__input" type="text" autocomplete="off" spellcheck="false"
      placeholder={t(lang, 'palette.placeholder')}
      role="combobox" aria-expanded="true" aria-controls="palette-list" aria-autocomplete="list"
    />
    <ul class="palette__list" id="palette-list" role="listbox" aria-label={t(lang, 'palette.title')}></ul>
    <p class="palette__empty" hidden>{t(lang, 'palette.empty')}</p>
    <p class="palette__hint meta" aria-hidden="true">↑↓ · Enter · Esc</p>
  </div>
</dialog>
<script type="application/json" id="palette-data" set:html={JSON.stringify({ items, lang, home: lp(lang, '/') })} />

<style>
  .palette {
    width: min(640px, calc(100% - 32px)); max-height: min(560px, calc(100% - 64px)); margin: 10vh auto auto;
    padding: 0; border: 1px solid var(--line-input); border-radius: var(--r-img);
    background: var(--surface); color: var(--text); box-shadow: 0 8px 32px rgba(0, 0, 0, 0.45);
  }
  .palette::backdrop { background: rgba(17, 17, 17, 0.6); }
  .palette__box { display: grid; grid-template-rows: auto 1fr auto auto; max-height: inherit; }
  .palette__input {
    width: 100%; min-height: 56px; padding: 0 var(--s-5); border: 0; border-bottom: 1px solid var(--line);
    background: transparent; color: var(--text); font: inherit; font-size: var(--fs-md);
  }
  .palette__input::placeholder { color: var(--text-quiet); }
  .palette__input:focus { outline: none; }
  .palette__list { list-style: none; overflow: auto; padding: var(--s-2); }
  .palette__list :global(li) {
    display: flex; justify-content: space-between; gap: var(--s-4); align-items: center;
    min-height: 44px; padding: 0 var(--s-4); border-radius: var(--r-btn); cursor: pointer;
  }
  .palette__list :global(li[aria-selected='true']) { background: var(--bg-band); outline: 1px solid var(--line-input); }
  .palette__list :global(.palette__kind) { font-size: var(--fs-xs); font-weight: var(--fw-regular); letter-spacing: var(--track-label); text-transform: uppercase; color: var(--text-quiet); white-space: nowrap; }
  .palette__empty { padding: var(--s-4) var(--s-5); color: var(--text-muted); }
  .palette__hint { padding: var(--s-3) var(--s-5); border-top: 1px solid var(--line); color: var(--text-quiet); }
</style>
