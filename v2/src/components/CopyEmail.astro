---
import { type Lang, t } from '../i18n/ui';
import { person } from '../data/site';
interface Props { lang: Lang; class?: string }
const { lang, class: cls = '' } = Astro.props;
---
<button class={`btn ${cls}`} type="button" data-copy={person.email} data-copied={t(lang, 'cta.copied')} hidden>
  <span data-copy-label aria-live="polite" aria-atomic="true">{t(lang, 'cta.copyEmail')}</span>
</button>
