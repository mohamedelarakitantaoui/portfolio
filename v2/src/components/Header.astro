---
import { type Lang, lp, t } from '../i18n/ui';
import { person } from '../data/site';
interface Props { lang: Lang; enPath: string; frPath: string }
const { lang, enPath, frPath } = Astro.props;
const other: Lang = lang === 'en' ? 'fr' : 'en';
const otherPath = other === 'en' ? enPath : frPath;
const here = Astro.url.pathname.replace(/\/$/, '') || '/';
const nav = [
  { href: lp(lang, '/work'), label: t(lang, 'nav.work') },
  { href: lp(lang, '/about'), label: t(lang, 'nav.about') },
  { href: lp(lang, '/services'), label: t(lang, 'nav.services') },
  { href: lp(lang, '/cv'), label: t(lang, 'nav.cv') },
  { href: lp(lang, '/contact'), label: t(lang, 'nav.contact') },
];
// Creative lives in the footer only (off-target for recruiters).
const isCurrent = (href: string) => here === href || (href !== '/' && here.startsWith(href + '/'));
---
<header class="site-header" id="site-header">
  <div class="site-header__inner wrap">
    <a class="logo" href={lp(lang, '/')} aria-label={t(lang, 'logo.label')}>{person.name}</a>

    <nav class="site-nav" aria-label={t(lang, 'nav.label')}>
      <ul>
        {nav.map((n) => (
          <li><a href={n.href} aria-current={isCurrent(n.href) ? 'page' : undefined}>{n.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="site-header__tools">
      <a class="pill lang-pill" href={otherPath} hreflang={other} lang={other}>
        <span class="sr-only">{t(lang, 'lang.switch')}</span>
        <span aria-hidden="true"><span class:list={{ on: lang === 'en' }}>EN</span><span class="lang-pill__sep">/</span><span class:list={{ on: lang === 'fr' }}>FR</span></span>
      </a>
      <a class="pill pill--light hire" href={`mailto:${person.email}`}>{t(lang, 'cta.emailMe')}</a>
      <a class="pill menu-btn" href="#footer-nav" data-menu-open aria-haspopup="dialog">{t(lang, 'nav.menu')}</a>
    </div>
  </div>
</header>

<!-- Floating pill after the hero (JS only; without JS the header and footer nav remain) -->
<button class="pill menu-pill" type="button" data-menu-open aria-haspopup="dialog" hidden>
  <span class="menu-pill__bars" aria-hidden="true"></span>{t(lang, 'nav.menu')}
</button>

<dialog class="menu" id="site-menu" aria-label={t(lang, 'nav.menu')} data-lenis-prevent>
  <div class="menu__inner wrap">
    <div class="menu__top">
      <a class="logo" href={lp(lang, '/')} aria-label={t(lang, 'logo.label')}>{person.name}</a>
      <button class="pill menu-close" type="button" data-menu-close>{t(lang, 'nav.close')}</button>
    </div>
    <nav aria-label={t(lang, 'nav.label')}>
      <ol class="menu__list">
        <li><a href={lp(lang, '/')}>{t(lang, 'nav.home')}</a></li>
        {nav.map((n) => (
          <li><a href={n.href} aria-current={isCurrent(n.href) ? 'page' : undefined}>{n.label}</a></li>
        ))}
      </ol>
    </nav>
    <div class="menu__foot">
      <a class="menu__email" href={`mailto:${person.email}`}>{person.email}</a>
      <a class="link" href={otherPath} hreflang={other} lang={other}>{t(lang, 'lang.switch')}</a>
    </div>
  </div>
</dialog>

<style>
  .site-header { position: absolute; inset: 0 0 auto 0; z-index: var(--z-header); }
  .site-header__inner {
    display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: var(--s-4);
    min-height: var(--header-h);
  }
  .logo {
    display: inline-flex; align-items: center; min-height: 44px; text-decoration: none;
    font-size: var(--fs-md); font-weight: 600; letter-spacing: -0.03em; color: var(--heading); white-space: nowrap;
  }

  .site-nav { display: none; justify-self: center; }
  .site-nav ul { display: flex; gap: var(--s-1); list-style: none; }
  .site-nav a {
    display: inline-flex; align-items: center; min-height: 44px; padding: 0 var(--s-3);
    text-decoration: none; font-size: var(--fs-nav); font-weight: 500; color: var(--text-muted);
    transition: color var(--dur-1) var(--ease-out);
  }
  .site-nav a:hover, .site-nav a[aria-current='page'] { color: var(--heading); }
  .site-nav a[aria-current='page'] { text-decoration: underline; text-decoration-color: var(--accent); text-underline-offset: 8px; }

  .site-header__tools { display: flex; align-items: center; gap: var(--s-2); justify-self: end; grid-column: 3; }
  .pill {
    display: inline-flex; align-items: center; justify-content: center; gap: var(--s-2);
    min-height: 44px; padding: 0 var(--s-4); border-radius: var(--r-pill);
    border: 1px solid var(--line-input); background: transparent; color: var(--heading);
    font-size: var(--fs-small); font-weight: 600; letter-spacing: -0.01em; text-decoration: none; cursor: pointer; white-space: nowrap;
    transition: border-color var(--dur-1) var(--ease-out), background-color var(--dur-1) var(--ease-out);
  }
  .pill:hover { border-color: var(--heading); }
  .pill--light { background: var(--heading); color: var(--bg); border-color: var(--heading); }
  .pill--light:hover { background: var(--bone-0); }
  .lang-pill { gap: 0; color: var(--text-quiet); }
  .lang-pill .on { color: var(--heading); }
  .lang-pill__sep { margin-inline: 0.3em; }
  .hire { display: none; }

  @media (min-width: 1024px) {
    .site-nav { display: block; }
    .hire { display: inline-flex; }
    .menu-btn { display: none; }
  }
  @media (max-width: 380px) { .logo { font-size: var(--fs-nav); } .lang-pill { padding: 0 var(--s-3); } }

  .menu-pill {
    position: fixed; z-index: var(--z-pill); left: 50%; bottom: max(16px, env(safe-area-inset-bottom));
    transform: translate(-50%, 0); min-height: 48px; padding: 0 var(--s-5);
    background: var(--surface); border-color: var(--line-strong);
    transition: opacity var(--dur-1) var(--ease-out), transform var(--dur-1) var(--ease-out), border-color var(--dur-1) var(--ease-out);
  }
  .menu-pill__bars { width: 14px; height: 7px; border-block: 1.5px solid currentColor; }
  .menu-pill.is-hidden { opacity: 0; transform: translate(-50%, 16px); pointer-events: none; }
  @media (min-width: 1024px) {
    .menu-pill { left: auto; right: var(--gutter); top: var(--s-4); bottom: auto; transform: none; }
    .menu-pill.is-hidden { transform: translateY(-12px); }
  }

  .menu {
    position: fixed; inset: 0; width: 100%; height: 100%; max-width: none; max-height: none;
    margin: 0; padding: 0; border: 0; background: var(--bg); color: var(--text); z-index: var(--z-menu);
  }
  .menu::backdrop { background: var(--bg); }
  .menu__inner { display: grid; grid-template-rows: auto 1fr auto; min-height: 100%; padding-block: 0 var(--s-6); }
  .menu__top { display: flex; justify-content: space-between; align-items: center; min-height: var(--header-h); }
  .menu__list { list-style: none; align-self: center; padding-block: var(--s-6); }
  .menu__list li + li { border-top: 1px solid var(--line); }
  .menu__list a {
    display: block; text-decoration: none; color: var(--heading);
    font-size: clamp(2.25rem, 7vw, 4.5rem); font-weight: 700; letter-spacing: var(--track-h); line-height: 1.1; padding-block: var(--s-2);
  }
  .menu__list a:hover, .menu__list a[aria-current='page'] { color: var(--accent); }
  .menu__foot { display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--s-4); align-items: center; border-top: 1px solid var(--line); padding-top: var(--s-5); }
  .menu__email { display: inline-flex; align-items: center; min-height: 44px; font-size: clamp(1.25rem, 3vw, 1.75rem); font-weight: 600; letter-spacing: var(--track-h); text-decoration-color: var(--line-strong); }
</style>
