---
// "More projects": one hairline row each (22px title · one line · year · links). Home shows the `home` rows, /work all.
import { moreProjects } from '../data/site';
import { type Lang, lp } from '../i18n/ui';
import { rich, shows } from '../lib/rich';
interface Props { lang: Lang; heading?: 'h2' | 'h3'; id?: string; homeOnly?: boolean }
const { lang, heading: H = 'h3', id = 'more-projects', homeOnly = false } = Astro.props;
const fr = lang === 'fr';
const rows = homeOnly ? moreProjects.filter((p) => p.home) : moreProjects;
---
<div class="more">
  <H class="more__h" id={id}>{fr ? 'Autres projets' : 'More projects'}</H>
  <ul class="rows more__rows" aria-labelledby={id}>
    {rows.map((p) => (
      <li class="more__row">
        <p class="more__title">{p.title}</p>
        <p class="more__line" set:html={rich(p.line[lang])} />
        <p class="more__year">{shows(p.year) ? <Fragment set:html={rich(p.year)} /> : ''}</p>
        <p class="more__links">
          {p.caseStudy && <a class="link" href={lp(lang, p.caseStudy)}>{fr ? 'Étude de cas' : 'Case study'}<span class="sr-only">: {p.title}</span></a>}
          {p.links.map((l) => <a class="link" href={l.href} target="_blank" rel="noopener">{l.label}<span class="sr-only"> ({p.title}, {fr ? 'nouvel onglet' : 'opens in a new tab'})</span></a>)}
        </p>
      </li>
    ))}
  </ul>
</div>

<style>
  .more__h { font-size: var(--fs-sub); letter-spacing: var(--track-h); margin-bottom: var(--s-4); }
  .more__row { display: grid; gap: var(--s-1) var(--s-5); padding-block: var(--s-5); }
  @media (min-width: 768px) {
    .more__row { grid-template-columns: minmax(0, 3fr) minmax(0, 6fr) 3.5rem minmax(0, 2.5fr); align-items: baseline; }
  }
  .more__title { font-size: var(--fs-row); font-weight: 500; letter-spacing: var(--track-h); line-height: 1.2; color: var(--heading); }
  .more__line { color: var(--text-muted); }
  @media (min-width: 768px) { .more__line { font-size: var(--fs-small); } }
  .more__year { color: var(--text-quiet); font-size: var(--fs-small); }
  .more__links { display: flex; flex-wrap: wrap; gap: 0 var(--s-4); font-size: var(--fs-small); }
  @media (min-width: 768px) { .more__links { justify-content: flex-end; } }
</style>
