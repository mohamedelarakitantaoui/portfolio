---
// "More projects": one hairline row each (title · one line · year · links). Home shows the `home` rows, /work all.
// Every row is a link to its page (case study or short project page): the title link covers the row; the external
// links (GitHub, Kaggle, live site) sit above it. A champagne hairline grows across the row on hover (effects on only).
import { moreProjects } from '../data/site';
import { type Lang, t } from '../i18n/ui';
import { allProjects, projectHref } from '../lib/projects';
import { rich, shows } from '../lib/rich';
interface Props { lang: Lang; heading?: 'h2' | 'h3'; id?: string; homeOnly?: boolean }
const { lang, heading: H = 'h3', id = 'more-projects', homeOnly = false } = Astro.props;
const fr = lang === 'fr';
const pages = await allProjects(lang);
const rows = (homeOnly ? moreProjects.filter((p) => p.home) : moreProjects)
  .map((p) => ({ ...p, page: pages.find((e) => e.data.key === p.key)! }));
const newTab = fr ? 'nouvel onglet' : 'opens in a new tab';
---
<div class="more">
  <H class="more__h" id={id}>{fr ? 'Autres projets' : 'More projects'}</H>
  <ul class="rows more__rows" aria-labelledby={id}>
    {rows.map((p) => (
      <li class="more__row" data-categories={p.page.data.category.join(' ')}>
        <p class="more__title"><a class="more__go" href={projectHref(lang, p.key)}>{p.title}</a></p>
        <p class="more__line" set:html={rich(p.line[lang])} />
        <p class="more__year">{shows(p.year) ? <Fragment set:html={rich(p.year)} /> : ''}</p>
        <p class="more__links">
          {p.links.map((l) => <a class="more__ext" href={l.href} target="_blank" rel="noopener">{l.label}<span aria-hidden="true"> ↗</span><span class="sr-only"> ({p.title}, {newTab})</span></a>)}
          <span class="more__cta meta" aria-hidden="true">{t(lang, p.page.data.caseStudy ? 'cs.label' : 'proj.label')} <span class="btn__arrow">→</span></span>
        </p>
      </li>
    ))}
  </ul>
</div>

<style>
  .more__h { font-size: var(--fs-sub); font-weight: var(--fw-light); letter-spacing: var(--track-h); margin-bottom: var(--s-4); }
  .more__row { position: relative; display: grid; gap: var(--s-1) var(--s-5); padding-block: var(--s-5); }
  .more__row::before {
    content: ''; position: absolute; top: -1px; left: 0; right: 0; height: 1px;
    background: var(--accent); transform: scaleX(0); transform-origin: left center; pointer-events: none;
  }
  :global(.fx-on) .more__row::before { transition: transform var(--dur-row) var(--ease-out); }
  :global(.fx-on) .more__row:hover::before { transform: scaleX(1); }
  @media (min-width: 768px) {
    .more__row { grid-template-columns: minmax(0, 3fr) minmax(0, 6fr) 3.5rem minmax(0, 2.5fr); align-items: baseline; }
  }
  .more__title { font-size: var(--fs-row); font-weight: var(--fw-light); letter-spacing: var(--track-h); line-height: 1.2; color: var(--heading); }
  .more__go { color: inherit; text-decoration: none; }
  /* The title link covers the whole row. */
  .more__go::after { content: ''; position: absolute; inset: 0; }
  .more__row:hover .more__go { text-decoration: underline; text-decoration-color: var(--accent); text-decoration-thickness: 1px; text-underline-offset: 0.15em; }
  .more__line { color: var(--text-muted); }
  .more__year { color: var(--text-quiet); font-size: var(--fs-small); }
  .more__links { display: flex; flex-wrap: wrap; align-items: center; gap: 0 var(--s-5); font-size: var(--fs-small); }
  .more__ext {
    position: relative; z-index: var(--z-raised); display: inline-flex; align-items: center; min-height: 44px;
    color: var(--text); text-decoration-color: var(--accent);
  }
  .more__ext:hover { color: var(--heading); }
  .more__cta { display: inline-flex; align-items: center; gap: var(--s-2); min-height: 44px; color: var(--text-muted); white-space: nowrap; }
  .more__row:hover .more__cta { color: var(--accent); }
  :global(.fx-on) .more__cta .btn__arrow { transition: transform var(--dur-btn) var(--ease-out); }
  :global(.fx-on) .more__row:hover .more__cta .btn__arrow { transform: translateX(4px); }
  @media (min-width: 768px) { .more__links { justify-content: flex-end; } }
</style>
