---
// Inner-page opener: label ↗ + display h1 (92px at desktop) + lede, on the hero panel colour.
interface Props { label: string; title: string; lede?: string }
const { label, title, lede } = Astro.props;
---
<section class="intro">
  <div class="wrap intro__inner">
    <p class="label">{label}</p>
    <h1 class="h1 intro__h1">{title}</h1>
    {lede && <p class="lede intro__lede">{lede}</p>}
    <slot />
  </div>
</section>

<style>
  .intro { background: var(--bg-band); padding-top: calc(var(--header-h) + var(--s-7)); padding-bottom: var(--s-7); border-bottom: 1px solid var(--line); }
  @media (min-width: 1024px) { .intro { padding-top: calc(var(--header-h) + var(--s-8)); padding-bottom: var(--s-8); } }
  .intro__h1 { max-width: 16ch; }
  @media (max-width: 767px) { .intro__h1 { font-size: var(--fs-h1-hero); } }
  .intro__lede { margin-top: var(--s-6); }
</style>
