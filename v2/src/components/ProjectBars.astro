---
// Card media for a project without a screenshot yet: its two real numbers as a before/after bar pair.
// One series, so no legend; both values are labelled directly; a table carries the same data for screen readers.
interface Bar { label: string; value: number; text: string }
interface Props { title: string; before: Bar; after: Bar }
const { title, before, after } = Astro.props;
const max = Math.max(before.value, after.value);
const frac = (v: number) => Math.max(0.02, v / max).toFixed(4);
---
<figure class="bars zoom" aria-label={title} data-fx="result-bars">
  <div class="bars__inner zoom__inner" aria-hidden="true">
    <p class="bars__title meta">{title}</p>
    <div class="bars__rows">
      {[['before', before], ['after', after]].map(([k, b]) => (
        <div class:list={['bars__row', `bars__row--${k}`]}>
          <span class="bars__label">{(b as Bar).label}</span>
          <span class="bars__track"><span class="bars__fill" style={`--f:${frac((b as Bar).value)}`}></span><span class="bars__value">{(b as Bar).text}</span></span>
        </div>
      ))}
    </div>
  </div>
  <table class="sr-only">
    <caption>{title}</caption>
    <tbody>
      <tr><th scope="row">{before.label}</th><td>{before.text}</td></tr>
      <tr><th scope="row">{after.label}</th><td>{after.text}</td></tr>
    </tbody>
  </table>
</figure>

<style>
  /* Height = content: caption, then the two bars directly under it, 32px padding. No ratio, no dead space. */
  .bars { position: relative; background: var(--accent-surface); border: 1px solid var(--accent-line); }
  .bars__inner { display: grid; gap: var(--s-6); padding: var(--s-7) var(--s-6); }
  .bars__rows { display: grid; gap: var(--s-5); }
  .bars__row { display: grid; gap: var(--s-3); }
  .bars__label { color: var(--text-muted); font-size: var(--fs-small); }
  .bars__track { display: flex; font-size: clamp(1.5rem, 1rem + 1.6vw, 2.5rem); align-items: center; gap: var(--s-3); }
  .bars__fill { display: block; height: clamp(16px, 2.4vw, 32px); width: calc((100% - 4.5em) * var(--f)); flex: none; border-radius: 0 4px 4px 0; background: var(--line-input); }
  .bars__row--after .bars__fill { background: var(--accent); }
  .bars__value { flex: none; color: var(--heading); font-size: 1em; font-weight: 700; letter-spacing: var(--track-h); line-height: 1; }
</style>
