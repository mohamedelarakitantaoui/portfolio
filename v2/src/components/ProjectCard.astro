---
// Card anatomy (v4): media (loop, screenshot or real-number bars) → meta → title → one-line outcome →
// metric line → "In progress" line if any → tags → "Case study ↗".
import type { CollectionEntry } from 'astro:content';
import ProjectMedia from './ProjectMedia.astro';
import { type Lang, lp, t } from '../i18n/ui';
import { rich } from '../lib/rich';
interface Props { project: CollectionEntry<'projects'>; lang: Lang; headingLevel?: 'h3' | 'h2' }
const { project, lang, headingLevel: H = 'h3' } = Astro.props;
const d = project.data;
const href = d.caseStudy && (import.meta.env.DEV || !d.draft) ? lp(lang, `/work/${d.key}`) : null;
// A loop carries its own play/pause button, so it is never wrapped in a link.
const linkMedia = href && !d.loop;
// Effect: the AneuXplain video grows into its column on scroll (src/scripts/effects/fx/media-grow.ts).
const grow = d.key === 'aneuxplain' ? 'media-grow' : undefined;
const metric = d.metric ?? (d.number ? `${d.number.value} · ${d.number.caption}` : null);
---
<article class="pcard" data-reveal>
  {linkMedia ? (
    <a class="pcard__media" href={href} tabindex="-1" aria-hidden="true" data-fx={grow}><ProjectMedia project={project} lang={lang} /></a>
  ) : (
    <div class="pcard__media" data-fx={grow}><ProjectMedia project={project} lang={lang} /></div>
  )}
  <div class="pcard__body">
    <p class="meta">{d.meta}</p>
    <H class="pcard__title">{href ? <a href={href}>{d.title}</a> : d.title}</H>
    <p class="pcard__outcome" set:html={rich(d.outcome)} />
    {metric && <p class="pcard__metric" set:html={rich(metric)} />}
    {d.progress && <p class="pcard__progress"><span class="pcard__dot" aria-hidden="true"></span><span set:html={rich(d.progress)} /></p>}
    <div class="pcard__foot">
      <ul class="tags" aria-label="Stack">{d.tags.slice(0, 4).map((tg) => <li class="tag">{tg}</li>)}</ul>
      {href && <a class="link" href={href} aria-hidden="true" tabindex="-1">{t(lang, 'cs.label')}</a>}
    </div>
  </div>
</article>

<style>
  .pcard { display: grid; gap: var(--s-5); align-content: start; }
  .pcard__media { display: block; text-decoration: none; color: inherit; }
  .pcard__body { display: grid; gap: var(--s-3); align-content: start; }
  .pcard__title { font-size: var(--fs-card); font-weight: 500; letter-spacing: var(--track-h); line-height: 1.2; margin-top: calc(-1 * var(--s-1)); }
  .pcard__title a { text-decoration: none; }
  .pcard__title a:hover { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.15em; }
  .pcard__outcome { color: var(--text-muted); max-width: 62ch; }
  .pcard__metric { color: var(--heading); font-weight: 600; padding-block: var(--s-3); border-block: 1px solid var(--line); max-width: none; }
  .pcard__progress { display: flex; gap: var(--s-3); align-items: baseline; color: var(--text); margin-top: calc(-1 * var(--s-3)); padding-bottom: var(--s-3); border-bottom: 1px solid var(--line); max-width: none; }
  .pcard__dot { flex: none; width: 7px; height: 7px; border-radius: 50%; background: var(--accent); transform: translateY(-1px); }
  .pcard__foot { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--s-3) var(--s-5); margin-top: var(--s-1); }
</style>
