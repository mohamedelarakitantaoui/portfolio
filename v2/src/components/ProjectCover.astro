---
// Real screenshot when one exists; otherwise a typographic poster (word behind the star, flow in mono).
// No stock imagery, no fake screenshots.
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Star from './Star.astro';
import type { Lang } from '../i18n/ui';
interface Props { project: CollectionEntry<'projects'>; lang: Lang; eager?: boolean; large?: boolean }
const { project, lang, eager = false, large = false } = Astro.props;
const d = project.data;
const posters: Record<string, { word: string; flow: Record<Lang, string> }> = {
  'dce-scraper': { word: 'DCE', flow: { en: '3 portals → 10 browsers → dataset', fr: '3 portails → 10 navigateurs → jeu de données' } },
  'secure-gov-rag': { word: 'RAG', flow: { en: 'docs → pgvector → Ollama → cited answer', fr: 'docs → pgvector → Ollama → réponse sourcée' } },
  aneuxplain: { word: 'Aneu', flow: { en: 'DICOM → mesh → PointNet → report', fr: 'DICOM → maillage → PointNet → rapport' } },
  esaha: { word: 'eSaha', flow: { en: 'React → 7 modules → Supabase', fr: 'React → 7 modules → Supabase' } },
  preparia: { word: 'H5P', flow: { en: 'WordPress + Elementor + H5P', fr: 'WordPress + Elementor + H5P' } },
};
const poster = posters[d.key];
---
<div class:list={['cover', { 'cover--large': large }]}>
  {d.cover ? (
    <Image
      src={d.cover}
      alt={d.coverAlt ?? ''}
      widths={[480, 720, 960, 1280]}
      sizes={large ? '(min-width: 1024px) 60vw, 100vw' : '(min-width: 1024px) 30vw, 100vw'}
      format="webp"
      loading={eager ? 'eager' : 'lazy'}
      class="cover__img"
    />
  ) : (
    <div class="cover__poster" aria-hidden="true">
      <span class="cover__word">{poster?.word ?? d.title}</span>
      <Star class="cover__star" />
      <span class="cover__flow mono">{poster?.flow[lang]}</span>
    </div>
  )}
</div>

<style>
  .cover { position: relative; aspect-ratio: 16 / 10; border-radius: var(--r-lg); overflow: hidden; background: var(--surface); border: 1px solid var(--line); }
  .cover__img { width: 100%; height: 100%; object-fit: cover; object-position: top center; }
  .cover__poster { position: absolute; inset: 0; display: grid; place-items: center; }
  .cover__word {
    font-family: var(--font-display); font-weight: 700; letter-spacing: -0.06em; line-height: 0.8;
    font-size: clamp(4rem, 13vw, 9rem); color: transparent; -webkit-text-stroke: 1.5px var(--bone-unlit);
    font-variation-settings: 'opsz' 96;
  }
  .cover--large .cover__word { font-size: clamp(5rem, 16vw, 13rem); }
  .cover__poster :global(.cover__star) {
    position: absolute; width: 13%; height: auto; aspect-ratio: 1; color: var(--accent-wall);
    left: 50%; top: 50%; transform: translate(-50%, -50%) rotate(0deg); transition: transform var(--dur-3) var(--ease-out);
  }
  .cover__flow { position: absolute; left: var(--s-4); bottom: var(--s-4); right: var(--s-4); color: var(--text-muted); font-size: 0.6875rem; text-transform: none; letter-spacing: 0.04em; }
  :global(a:hover) .cover__poster :global(.cover__star) { transform: translate(-50%, -50%) rotate(45deg); }
</style>
