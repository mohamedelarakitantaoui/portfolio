---
// Real product only: a muted loop of the app, a real screenshot, or the project's two real numbers as bars.
// No media at all: nothing in production, a dashed "screenshot needed" box in `astro dev`.
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import ProjectBars from './ProjectBars.astro';
import type { Lang } from '../i18n/ui';
interface Props { project: CollectionEntry<'projects'>; lang: Lang; eager?: boolean; ratio?: string }
const { project, lang, eager = false, ratio = '16 / 9' } = Astro.props;
const d = project.data;
const fr = lang === 'fr';
const sizes = '(min-width: 1024px) 58vw, 100vw';
---
{d.loop ? (
  <div class="media zoom" style={`--ratio:${ratio}`}>
    <video class="media__el" data-loop muted loop playsinline preload="none" poster={d.loop.poster} width="1280" height="690" aria-label={d.loop.alt}>
      <source src={d.loop.webm} type="video/webm" />
      <source src={d.loop.mp4} type="video/mp4" />
    </video>
    <button class="media__toggle" type="button" data-loop-toggle hidden data-play={fr ? 'Lire' : 'Play'} data-pause="Pause">
      <span data-loop-label>{fr ? 'Lire' : 'Play'}</span>
    </button>
  </div>
) : d.cover ? (
  <div class="media zoom" style={`--ratio:${ratio}`}>
    <Image src={d.cover} alt={d.coverAlt ?? ''} widths={[480, 760, 1140, 1520]} sizes={sizes} format="webp" loading={eager ? 'eager' : 'lazy'} class="media__el" />
  </div>
) : d.bars ? (
  <ProjectBars {...d.bars} />
) : import.meta.env.DEV ? (
  <div class="media media--missing" style={`--ratio:${ratio}`}><span class="todo">{fr ? `capture réelle de ${d.title} (pas de données client)` : `a real screenshot of ${d.title} (no client data)`}</span></div>
) : null}

<style>
  /* v5: real product media sits in a 1px --line frame on --surface, dimmed to 85% so a light app screen never
     outshines the page. */
  .media { position: relative; aspect-ratio: var(--ratio); border-radius: var(--r-img); overflow: hidden; background: var(--surface); border: 1px solid var(--line); }
  .media__el { width: 100%; height: 100%; object-fit: cover; object-position: top center; display: block; filter: var(--dim-screen); }
  .media--missing { display: grid; place-items: center; padding: var(--s-5); border: 1px dashed var(--line-strong); }
  .media__toggle {
    position: absolute; right: var(--s-3); bottom: var(--s-3); min-height: 44px; min-width: 44px; padding: 0 var(--s-4);
    border-radius: var(--r-pill); border: 1px solid rgba(255, 255, 255, 0.3); background: rgba(12, 12, 12, 0.78); color: var(--white);
    font-size: var(--fs-tag); font-weight: var(--fw-regular); cursor: pointer;
  }
  .media__toggle:hover { border-color: var(--white); }
  .media__toggle.is-big { inset: 50% auto auto 50%; transform: translate(-50%, -50%); min-height: 56px; padding: 0 var(--s-6); background: var(--accent); color: var(--accent-ink); border-color: transparent; }
</style>
