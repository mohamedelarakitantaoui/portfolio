---
// Real product only: a muted loop of the app, or a real screenshot. No illustrations, no outlined-letter posters.
// No media yet: nothing in production, a dashed "screenshot needed" box in `astro dev`.
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import type { Lang } from '../i18n/ui';
interface Props { project: CollectionEntry<'projects'>; lang: Lang; eager?: boolean; large?: boolean }
const { project, lang, eager = false, large = false } = Astro.props;
const d = project.data;
const fr = lang === 'fr';
const sizes = large ? '(min-width: 1024px) 760px, 100vw' : '(min-width: 1024px) 370px, (min-width: 768px) 50vw, 100vw';
---
{d.loop ? (
  <div class:list={['media', { 'media--large': large }]}>
    <video class="media__el" data-loop muted loop playsinline preload="none" poster={d.loop.poster} width="1280" height="690" aria-label={d.loop.alt}>
      <source src={d.loop.webm} type="video/webm" />
      <source src={d.loop.mp4} type="video/mp4" />
    </video>
    <button class="media__toggle mono" type="button" data-loop-toggle hidden data-play={fr ? 'Lire' : 'Play'} data-pause="Pause">
      <span data-loop-label>{fr ? 'Lire' : 'Play'}</span>
    </button>
  </div>
) : d.cover ? (
  <div class:list={['media', { 'media--large': large }]}>
    <Image src={d.cover} alt={d.coverAlt ?? ''} widths={[480, 760, 1140, 1520]} sizes={sizes} format="webp" loading={eager ? 'eager' : 'lazy'} class="media__el" />
  </div>
) : import.meta.env.DEV ? (
  <div class="media media--missing"><span class="todo">{fr ? `capture réelle de ${d.title} (pas de données client)` : `a real screenshot of ${d.title} (no client data)`}</span></div>
) : null}

<style>
  .media { position: relative; aspect-ratio: 16 / 10; border-radius: var(--r-lg); overflow: hidden; background: var(--surface); border: 1px solid var(--line); }
  .media__el { width: 100%; height: 100%; object-fit: cover; object-position: top center; display: block; }
  .media--missing { display: grid; place-items: center; padding: var(--s-5); border-style: dashed; }
  .media__toggle {
    position: absolute; right: var(--s-3); bottom: var(--s-3); min-height: 44px; min-width: 44px; padding: 0 var(--s-4);
    border-radius: var(--r-pill); border: 1px solid var(--line-input); background: rgba(17, 17, 17, 0.78); color: #f2f0ea; cursor: pointer;
  }
  .media__toggle:hover { border-color: #f2f0ea; }
  .media__toggle.is-big { inset: 50% auto auto 50%; transform: translate(-50%, -50%); min-height: 56px; padding: 0 var(--s-6); }
</style>
