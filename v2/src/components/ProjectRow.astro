---
// v5 home project row (hairline, 3 columns): meta + title + tags | real media (the AneuXplain loop) or the flat
// before/after bars, outcome, champagne metric, "In progress" line | "Case study →".
// A champagne hairline grows across the row on hover (effects on only). /work keeps ProjectCard.
import type { CollectionEntry } from 'astro:content';
import ProjectMedia from './ProjectMedia.astro';
import ProjectBars from './ProjectBars.astro';
import { type Lang, lp, t } from '../i18n/ui';
import { rich } from '../lib/rich';
interface Props { project: CollectionEntry<'projects'>; lang: Lang }
const { project, lang } = Astro.props;
const d = project.data;
const href = d.caseStudy && (import.meta.env.DEV || !d.draft) ? lp(lang, `/work/${d.key}`) : null;
const metric = d.metric ?? (d.number ? `${d.number.value} · ${d.number.caption}` : null);
// Effect: the AneuXplain video grows into its column on scroll (src/scripts/effects/fx/media-grow.ts).
const grow = d.key === 'aneuxplain' ? 'media-grow' : undefined;
---
<li class="prow" data-reveal>
  <div class="prow__id">
    <p class="meta prow__meta">{d.meta}</p>
    <h3 class="prow__title">{href ? <a href={href}>{d.title}</a> : d.title}</h3>
    <ul class="tags prow__tags" aria-label="Stack">{d.tags.slice(0, 4).map((tg) => <li class="tag">{tg}</li>)}</ul>
  </div>
  <div class="prow__body">
    {(d.loop || d.cover) && <div class="prow__media" data-fx={grow}><ProjectMedia project={project} lang={lang} /></div>}
    <p class="prow__outcome" set:html={rich(d.outcome)} />
    {d.bars && !d.loop && <ProjectBars {...d.bars} flat lang={lang} />}
    {metric && <p class="prow__metric" set:html={rich(metric)} />}
    {d.progress && <p class="prow__progress" set:html={rich(d.progress)} />}
  </div>
  {href && <a class="prow__link meta" href={href} aria-hidden="true" tabindex="-1">{t(lang, 'cs.label')} <span class="btn__arrow">→</span></a>}
</li>

<style>
  .prow {
    position: relative; display: grid; gap: var(--s-4);
    padding-block: var(--s-7); border-top: 1px solid var(--line);
  }
  .prow:last-child { border-bottom: 1px solid var(--line); }
  /* Hover: a champagne hairline grows across the top border (transform only, effects on only). */
  .prow::before {
    content: ''; position: absolute; top: -1px; left: 0; right: 0; height: 1px;
    background: var(--accent); transform: scaleX(0); transform-origin: left center;
  }
  :global(.fx-on) .prow::before { transition: transform var(--dur-row) var(--ease-out); }
  :global(.fx-on) .prow:hover::before { transform: scaleX(1); }
  .prow__id { display: grid; gap: var(--s-2); align-content: start; }
  .prow__meta { color: var(--text-muted); }
  .prow__title {
    font-size: var(--fs-card); font-weight: var(--fw-light); line-height: 1.05; letter-spacing: var(--track-h);
  }
  .prow__title a { text-decoration: none; }
  .prow__title a:hover { text-decoration: underline; text-decoration-color: var(--accent); text-decoration-thickness: 1px; text-underline-offset: 0.15em; }
  .prow__tags { margin-top: var(--s-2); }
  .prow__body { display: grid; gap: var(--s-4); align-content: start; min-width: 0; }
  .prow__media { min-width: 0; }
  .prow__outcome { max-width: 52ch; color: var(--text); }
  .prow__metric { font-size: var(--fs-small); color: var(--accent); letter-spacing: 0.02em; }
  .prow__progress { font-size: var(--fs-small); color: var(--text-muted); }
  .prow__link {
    display: inline-flex; align-items: center; gap: var(--s-2); min-height: 44px; align-self: start;
    color: var(--text-muted); text-decoration: none; white-space: nowrap;
  }
  .prow__link:hover { color: var(--accent); }
  :global(.fx-on) .prow__link .btn__arrow { transition: transform var(--dur-btn) var(--ease-out); }
  :global(.fx-on) .prow:hover .prow__link .btn__arrow { transform: translateX(4px); }
  @media (min-width: 900px) {
    .prow { grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.5fr) auto; gap: var(--s-6); }
  }
</style>
