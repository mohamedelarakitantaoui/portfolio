---
// The mark: one continuous {8/3} star polygon, stroke only, never filled.
// `weight` is the stroke in viewBox units, so it scales with the mark (default 8 = 1.76px at 22px).
// `px` pins a minimum on-screen stroke instead (non-scaling), used for marks smaller than ~20px.
import { STAR_POINTS } from '../lib/rich';
interface Props { class?: string; label?: string; weight?: number; px?: number; draw?: boolean }
const { class: cls = '', label, weight = 8, px, draw = false } = Astro.props;
---
<svg
  class={cls}
  viewBox="0 0 100 100"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
  overflow="visible"
>
  <polygon
    points={STAR_POINTS}
    fill="none"
    stroke="currentColor"
    stroke-width={px ?? weight}
    stroke-linejoin="miter"
    stroke-miterlimit="4"
    vector-effect={px ? 'non-scaling-stroke' : undefined}
    pathLength={draw ? 1 : undefined}
  />
</svg>
