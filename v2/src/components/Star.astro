---
// The khatam: 8-point star made of two overlapping squares. The site's one symbol.
import { STAR_PATH } from '../lib/rich';
interface Props { class?: string; label?: string; stroke?: boolean }
const { class: cls = '', label, stroke = false } = Astro.props;
---
<svg
  class={cls}
  viewBox="0 0 100 100"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
>
  {stroke
    ? <path d={STAR_PATH} fill="none" stroke="currentColor" stroke-width="3" stroke-linejoin="miter" pathLength="1" />
    : <path d={STAR_PATH} fill="currentColor" />}
</svg>
