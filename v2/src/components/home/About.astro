---
// About statement (v5): centred label, claim, lead and link (no photo: the hero portrait is the only one). The claim's words scrub from
// dim to bone with the scroll (effect word-scrub, off with the kill switch and under reduced motion).
import { aboutStatement } from '../../data/site';
import { type Lang, lp } from '../../i18n/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;
const fr = lang === 'fr';
---
<section class="about section" aria-labelledby="about-h">
  <div class="wrap about__grid">
    <div class="about__text">
      <p class="label">02 / {fr ? 'Ma façon de travailler' : 'How I work'}</p>
      <h2 class="h-statement about__h" id="about-h" data-fx="word-scrub">{fr ? 'Un score ne raconte pas toute l’histoire.' : 'There’s more to a model than its score.'}</h2>
      <p class="lede about__lead">{aboutStatement.lead[lang]}</p>
      <a class="link about__more" href={lp(lang, '/about')}>{fr ? 'En savoir plus' : 'More about me'}</a>
    </div>
  </div>
</section>

<style>
  .about { text-align: center; }
  .about__grid { display: grid; justify-items: center; }
  .about__text { display: grid; justify-items: center; }
  .about__h { max-width: 22ch; margin-inline: auto; }
  .about__h :global(.w) { display: inline-block; }
  .about__lead { margin-top: var(--s-6); max-width: 52ch; margin-inline: auto; }
  .about__more { margin-top: var(--s-4); }
</style>
