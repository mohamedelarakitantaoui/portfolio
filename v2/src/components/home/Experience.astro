---
// Experience rows (v4): date left · "Role · Company" + one result line right.
import { education, experience } from '../../data/site';
import { type Lang, lp, t } from '../../i18n/ui';
import { rich, shows } from '../../lib/rich';
interface Props { lang: Lang }
const { lang } = Astro.props;
const fr = lang === 'fr';
const rows = experience.filter((e) => e.home);
---
<section class="exp section band" aria-labelledby="exp-h2" id="experience" data-fx="exp-light">
  <div class="wrap grid-12">
    <div class="exp__head">
      <p class="label">{fr ? 'Expérience' : 'Experience'}</p>
      <h2 class="h2" id="exp-h2">{fr ? 'Deux stages, et ce qui a changé après chacun.' : 'Two internships, and what changed after each.'}</h2>
    </div>
    <ol class="rows exp__rows">
      {rows.map((e) => (
        <li class="exp__row" data-reveal>
          <p class="exp__when"><span class="exp__year">{e.year}</span>{shows(e.span[lang]) && <span set:html={rich(e.span[lang])} />}</p>
          <div class="exp__main">
            <h3 class="exp__title">
              <span set:html={rich(e.role[lang])} /><span class="exp__sep" aria-hidden="true"> · </span><span class="sr-only">, </span><span class="exp__org">{e.org}</span>
            </h3>
            {shows(e.line[lang]) && <p class="exp__line" set:html={rich(e.line[lang])} />}
            {e.href && <a class="link exp__cs" href={lp(lang, e.href)}>{t(lang, 'cs.label')}<span class="sr-only">: {e.org}</span></a>}
          </div>
        </li>
      ))}
    </ol>
    <div class="exp__edu">
      <p class="exp__edu-line">{education.map((ed) => ed.short[lang]).join(' · ')}</p>
      <a class="link" href={lp(lang, '/cv')}>{t(lang, 'cta.fullCv')}</a>
    </div>
  </div>
</section>

<style>
  /* Effect (src/scripts/effects/fx/exp-light.ts): a paper layer fades in behind the content; the text colours swap
     while the content is briefly hidden, so no visible text ever sits on a mid-grey. */
  .exp { position: relative; isolation: isolate; }
  .exp > .wrap { position: relative; z-index: 1; }
  .exp :global(.exp__paper) { position: absolute; inset: 0; background: var(--paper); opacity: 0; pointer-events: none; }
  .exp:global(.is-light) {
    --heading: var(--paper-ink); --text: var(--paper-ink); --text-muted: var(--paper-muted); --text-quiet: var(--paper-quiet);
    --accent: var(--paper-accent); --line: var(--paper-line); --line-strong: var(--paper-line-strong); --line-input: var(--paper-line-input);
  }
  .exp__head { margin-bottom: var(--s-8); }
  .exp__head .h2 { max-width: 16ch; }
  .exp__row { display: grid; gap: var(--s-2) var(--grid-gap); padding-block: var(--s-6); }
  .exp__when { display: flex; gap: var(--s-3); align-items: baseline; color: var(--text-quiet); font-size: var(--fs-small); }
  .exp__year { color: var(--heading); font-weight: 600; }
  .exp__title { font-size: var(--fs-row); font-weight: 500; letter-spacing: var(--track-h); line-height: 1.3; }
  .exp__sep, .exp__org { color: var(--text-muted); }
  .exp__line { margin-top: var(--s-2); color: var(--text-muted); }
  .exp__cs { margin-top: var(--s-1); font-size: var(--fs-small); }
  .exp__edu { display: flex; flex-wrap: wrap; gap: var(--s-3) var(--s-6); align-items: center; justify-content: space-between; margin-top: var(--s-6); }
  .exp__edu-line { color: var(--text-muted); }
  @media (min-width: 768px) {
    .exp__row { grid-template-columns: minmax(0, 3fr) minmax(0, 9fr); }
    .exp__when { flex-direction: column; gap: 2px; padding-top: 0.25em; }
  }
  @media (min-width: 1024px) {
    .exp__row { grid-template-columns: repeat(12, minmax(0, 1fr)); }
    .exp__when { grid-column: 1 / span 4; }
    .exp__main { grid-column: 6 / -1; }
  }
</style>
