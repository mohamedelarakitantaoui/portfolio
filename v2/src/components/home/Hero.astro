---
// Hero (v4): giant MAMOUN behind the centred cutout portrait; bottom-left role + h1 + two actions;
// bottom-right three proof rows. Static HTML, painted on first load: no preloader, nothing waits for JS.
import { heroPortrait, PORTRAIT_SIZES } from '../../lib/portrait';
import { type Lang, t } from '../../i18n/ui';
import { hero, person } from '../../data/site';
import { cvLink } from '../../lib/cv';
interface Props { lang: Lang }
const { lang } = Astro.props;
const img = await heroPortrait();
const cv = cvLink(lang);
---
<section class="hero" aria-labelledby="hero-h1" data-fx="hero-depth">
  <div class="hero__stage">
    <p class="hero__word" aria-hidden="true">MAMOUN</p>
    <div class="hero__portrait">
      <picture>
        <source type="image/avif" srcset={img.avif} sizes={PORTRAIT_SIZES} />
        <source type="image/webp" srcset={img.webp} sizes={PORTRAIT_SIZES} />
        <img src={img.fallback} width={img.width} height={img.height} alt={lang === 'fr' ? 'Portrait de Mamoun El Araki' : 'Portrait of Mamoun El Araki'} loading="eager" fetchpriority="high" decoding="sync" />
      </picture>
    </div>
  </div>

  <div class="hero__text">
    <p class="hero__role label label--plain">{person.role[lang]}</p>
    <h1 class="hero__h1" id="hero-h1">{hero.h1[lang]}</h1>
    <div class="hero__ctas">
      <a class="btn btn--primary" href="#work">{t(lang, 'cta.viewWork')}</a>
      <a class="link" href={cv.href}>{t(lang, 'cta.downloadCv')}</a>
    </div>
  </div>

  <dl class="hero__proof">
    {hero.stats.map((s) => (
      <div class="hero__stat">
        <dt>{s.value[lang]}</dt>
        <dd>{s.label[lang]}</dd>
      </div>
    ))}
  </dl>
</section>

<style>
  /* ---------- mobile first: stage (word + photo) → text → proof ---------- */
  .hero {
    position: relative; overflow: clip; background: var(--bg-band);
    padding: var(--header-h) var(--gutter) var(--s-7);
    display: grid; grid-template-columns: 100%; grid-template-areas: 'stage' 'text' 'proof';
  }
  .hero__stage { grid-area: stage; position: relative; height: clamp(250px, 66vw, 420px); margin-inline: calc(-1 * var(--gutter)); }
  .hero__word {
    position: absolute; left: 50%; top: 4%; transform: translateX(-50%); z-index: 1; margin: 0; max-width: none;
    font-size: 21.5vw; font-weight: 700; letter-spacing: -0.065em; line-height: 0.8; padding-inline-end: 0.065em;
    color: var(--heading); white-space: nowrap; user-select: none;
  }
  .hero__portrait {
    position: absolute; z-index: 2; left: 50%; bottom: 0; transform: translateX(-50%);
    height: 92%; aspect-ratio: 1212 / 1156;
    --fade: linear-gradient(to bottom, #000 62%, transparent 99%), linear-gradient(to right, transparent 2%, #000 24%, #000 76%, transparent 98%);
    -webkit-mask-image: var(--fade); -webkit-mask-composite: source-in;
    mask-image: var(--fade); mask-composite: intersect;
  }
  .hero__portrait :global(picture), .hero__portrait :global(img) { width: 100%; height: 100%; }

  .hero__text { grid-area: text; position: relative; z-index: 3; margin-top: var(--s-4); }
  .hero__role { margin-bottom: var(--s-3); }
  .hero__h1 {
    font-size: var(--fs-h1-hero); font-weight: 700; letter-spacing: var(--track-h); line-height: 1;
    text-wrap: balance; max-width: 14ch;
  }
  .hero__ctas { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-3) var(--s-5); margin-top: var(--s-5); }

  .hero__proof { grid-area: proof; position: relative; z-index: 3; margin-top: var(--s-7); border-top: 1px solid var(--line); }
  .hero__stat { display: flex; align-items: baseline; justify-content: space-between; gap: var(--s-4); padding-block: var(--s-3); border-bottom: 1px solid var(--line); }
  .hero__stat dt { font-size: var(--fs-sub); font-weight: 700; letter-spacing: var(--track-h); line-height: 1.1; color: var(--heading); white-space: nowrap; }
  .hero__stat dd { color: var(--text-muted); font-size: var(--fs-small); text-align: end; }

  /* ---------- desktop poster: one screen, corners used ---------- */
  @media (min-width: 1024px) {
    .hero { display: block; height: 100svh; min-height: 700px; max-height: 1120px; padding: 0; }
    .hero__stage { position: absolute; inset: 0; height: auto; margin: 0; }
    .hero__word { top: calc(var(--header-h) + 6svh); font-size: min(24vw, 34svh, 30rem); }
    .hero__portrait {
      height: min(66svh, 720px);
      --fade: linear-gradient(to bottom, #000 62%, transparent 99%), linear-gradient(to right, transparent 6%, #000 36%, #000 70%, transparent 96%);
    }
    .hero__text {
      position: absolute; margin: 0; bottom: clamp(40px, 6svh, 72px);
      left: max(var(--gutter), calc((100vw - var(--max)) / 2));
      width: min(30vw, 520px);
    }
    .hero__h1 { max-width: none; }
    .hero__proof {
      position: absolute; margin: 0; bottom: clamp(40px, 6svh, 72px);
      right: max(var(--gutter), calc((100vw - var(--max)) / 2));
      width: min(22vw, 320px);
    }
    .hero__stat { display: grid; gap: var(--s-1); padding-block: var(--s-4); }
    .hero__stat dd { text-align: start; }
  }
  @media (min-width: 1024px) and (max-height: 820px) {
    .hero__h1 { font-size: clamp(2.25rem, 3.4vw, 3.5rem); }
    .hero__stat { padding-block: var(--s-3); }
  }
</style>
