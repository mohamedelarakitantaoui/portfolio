---
import { heroPortrait, PORTRAIT_SIZES } from '../../lib/portrait';
import { type Lang, lp, t } from '../../i18n/ui';
import { person } from '../../data/site';
import { cvLink } from '../../lib/cv';
interface Props { lang: Lang }
const { lang } = Astro.props;
const fr = lang === 'fr';
const img = await heroPortrait();
const cv = cvLink(lang);
---
<section class="hero" aria-labelledby="hero-h1" data-fx="portrait-depth">
  <div class="wrap hero__grid">
    <div class="hero__text">
      <p class="hero__eyebrow meta"><span class="hero__dash" aria-hidden="true"></span>{person.role[lang]}</p>
      <h1 class="hero__h1" id="hero-h1"><span>Mamoun</span><span>El Araki<span class="hero__period">.</span></span></h1>
      <div class="hero__intro-row">
        <p class="hero__intro">{fr
          ? 'De l’imagerie médicale en 3D aux modèles de football. Je construis les modèles et les logiciels qui les rendent utilisables.'
          : 'From 3D medical imaging to football models. I build the models and the software that makes them usable.'}</p>
        <a class="hero__work" href="#work" data-fx="magnetic-link">
          <span aria-hidden="true">↘</span><span>{t(lang, 'cta.viewWork')}</span>
        </a>
      </div>
      <a class="link hero__cv" href={cv.href}>{t(lang, 'cta.downloadCv')}</a>
    </div>
    <div class="hero__visual">
      <div class="hero__frame">
        <svg class="hero__contours" viewBox="0 0 500 600" fill="none" aria-hidden="true">
          <ellipse cx="250" cy="310" rx="205" ry="270" />
          <ellipse cx="250" cy="310" rx="150" ry="270" />
          <ellipse cx="250" cy="310" rx="80" ry="270" />
          <path d="M45 310h410M65 190h370M65 430h370" />
        </svg>
        <p class="hero__frame-label meta" aria-hidden="true">{fr ? 'Modèles / Code / Applications' : 'Models / Code / Applications'}</p>
        <div class="hero__portrait">
          <picture>
            <source type="image/avif" srcset={img.avif} sizes={PORTRAIT_SIZES} />
            <source type="image/webp" srcset={img.webp} sizes={PORTRAIT_SIZES} />
            <img src={img.fallback} width={img.width} height={img.height} alt={fr ? 'Portrait de Mamoun El Araki' : 'Portrait of Mamoun El Araki'} loading="eager" fetchpriority="high" decoding="async" />
          </picture>
        </div>
        <a class="hero__feature" href={lp(lang, '/work/aneuxplain')}>
          <span class="hero__feature-label">{fr ? 'Mon projet de fin d’études' : 'My capstone project'}</span>
          <span class="hero__feature-title">AneuXplain <span aria-hidden="true">↗</span></span>
          <span class="hero__feature-note">{fr ? 'Article accepté · ICOA 2026' : 'Paper accepted · ICOA 2026'}</span>
        </a>
      </div>
    </div>
    <div class="hero__bottom">
      <p>{person.location[lang]}</p>
      <p class="hero__availability"><span aria-hidden="true"></span>{fr ? 'Ouvert aux postes junior et au freelance' : 'Open to junior roles & freelance projects'}</p>
      <a href="#work" class="hero__scroll">{fr ? 'Explorer' : 'Scroll to explore'} <span aria-hidden="true">↓</span></a>
    </div>
  </div>
</section>

<style>
  .hero { position: relative; overflow: clip; padding-top: calc(var(--header-h) + var(--s-7)); background: var(--bg-band); }
  .hero__grid { display: grid; gap: var(--s-7) var(--s-8); align-items: center; }
  .hero__text { position: relative; z-index: var(--z-raised); }
  .hero__eyebrow { display: flex; align-items: center; gap: var(--s-3); margin-bottom: var(--s-6); color: var(--text); }
  .hero__dash { width: var(--s-6); height: 1px; background: var(--accent); flex: none; }
  .hero__h1 { font-size: var(--fs-name); font-weight: 600; letter-spacing: var(--track-display); line-height: 0.86; text-transform: uppercase; }
  .hero__h1 > span { display: block; white-space: nowrap; }
  .hero__h1 > span + span { margin-top: var(--s-3); color: var(--accent); }
  .hero__period { color: var(--heading); }
  .hero__intro-row { display: flex; align-items: center; gap: var(--s-5); margin-top: var(--s-7); }
  .hero__intro { max-width: 33ch; font-size: var(--fs-lede); color: var(--text-muted); line-height: 1.65; }
  .hero__work { display: grid; place-content: center; gap: var(--s-2); text-align: center; flex: none; width: 120px; height: 120px; border: 1px solid var(--accent-line); border-radius: 50%; text-decoration: none; background: var(--accent); color: var(--accent-ink); font-size: var(--fs-small); }
  .hero__work > span:first-child { font-size: var(--fs-sub); line-height: 1; }
  .hero__work:hover { background: var(--accent-hover); }
  .hero__cv { margin-top: var(--s-5); font-size: var(--fs-small); }
  .hero__visual { min-width: 0; }
  .hero__frame { position: relative; aspect-ratio: 1 / 1.07; background: var(--portrait-surface); border-radius: 48% 48% var(--r-img) var(--r-img); isolation: isolate; }
  .hero__contours { position: absolute; inset: 0; width: 100%; height: 100%; stroke: var(--accent-line); stroke-width: 1; }
  .hero__frame-label { position: absolute; top: 10%; left: 50%; transform: translateX(-50%); white-space: nowrap; font-size: var(--fs-xs); color: var(--accent); }
  .hero__portrait { position: absolute; inset: 13% -5% 0; overflow: clip; }
  .hero__portrait picture { display: block; height: 100%; }
  .hero__portrait img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 0; mask-image: linear-gradient(to bottom, var(--mask-solid) 75%, transparent); }
  .hero__feature { position: absolute; inset: auto var(--s-5) var(--s-5); padding: var(--s-4) var(--s-5); background: var(--bg); border: 1px solid var(--line-strong); border-radius: var(--r-img); display: grid; gap: var(--s-1); text-decoration: none; transition: transform var(--dur-1) var(--ease-out); }
  .hero__feature:hover { transform: translateY(-4px); border-color: var(--accent); }
  .hero__feature-label, .hero__feature-note { color: var(--text-muted); font-size: var(--fs-small); }
  .hero__feature-title { display: flex; justify-content: space-between; gap: var(--s-5); font-size: var(--fs-sub); letter-spacing: var(--track-h); color: var(--heading); }
  .hero__feature-title > span { color: var(--accent); }
  .hero__bottom { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--s-4) var(--s-6); border-top: 1px solid var(--line); padding-block: var(--s-5); font-size: var(--fs-small); color: var(--text-muted); }
  .hero__availability { display: flex; align-items: center; gap: var(--s-2); }
  .hero__availability > span { width: 6px; height: 6px; border-radius: 50%; background: var(--accent); flex: none; }
  .hero__scroll { display: inline-flex; min-height: 44px; gap: var(--s-5); align-items: center; text-decoration: none; }
  .hero__scroll span { color: var(--accent); }
  @media (min-width: 768px) {
    .hero__grid { grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); gap: var(--s-7) var(--s-6); }
    .hero__visual { padding-inline-start: var(--s-5); }
    .hero__bottom { grid-column: 1 / -1; }
  }
  @media (min-width: 1200px) { .hero__visual { padding-inline: var(--s-8) var(--s-5); } }
  @media (max-width: 1023px) and (min-width: 768px) { .hero__work { width: 96px; height: 96px; } .hero__intro { font-size: var(--fs-body); } }
  @media (max-width: 767px) {
    .hero__h1 { font-size: clamp(3rem, 14vw, 6rem); }
    .hero__intro-row { margin-top: var(--s-6); }
    .hero__intro { font-size: var(--fs-body); }
    .hero__work { width: 94px; height: 94px; font-size: var(--fs-xs); }
    .hero__frame { max-width: 440px; margin-inline: auto; }
    .hero__bottom { gap: var(--s-3); }
  }
</style>
