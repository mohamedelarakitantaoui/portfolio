---
// v5 hero: centred portrait, clear face, centred headline and actions below, then the stats.
import { heroPortrait, PORTRAIT_SIZES } from '../../lib/portrait';
import { type Lang, lp, t } from '../../i18n/ui';
import { hero, person, status } from '../../data/site';
import { cvLink } from '../../lib/cv';
import { rich } from '../../lib/rich';
import { splitClause } from '../../lib/split';
interface Props { lang: Lang }
const { lang } = Astro.props;
const fr = lang === 'fr';
const img = await heroPortrait();
const cv = cvLink(lang);
const [h1a, h1b] = splitClause(hero.h1[lang]);
---
<section class="hero" aria-labelledby="hero-h1" data-fx="portrait-depth">
  <div class="wrap hero__inner">
    <div class="hero__stage">
      <div class="hero__portrait">
        <picture>
          <source type="image/avif" srcset={img.avif} sizes={PORTRAIT_SIZES} />
          <source type="image/webp" srcset={img.webp} sizes={PORTRAIT_SIZES} />
          <img src={img.fallback} width={img.width} height={img.height} alt={fr ? 'Portrait de Mamoun El Araki' : 'Portrait of Mamoun El Araki'} loading="eager" fetchpriority="high" decoding="async" />
        </picture>
      </div>
      <div class="hero__copy">
        <p class="hero__role meta"><span class="hero__name">{person.name}</span><span class="hero__sep" aria-hidden="true">·</span><span class="sr-only">, </span><span class="hero__phrases"><span>{person.role[lang]}</span><span class="hero__sep" aria-hidden="true">·</span><span class="sr-only">, </span><span>{fr ? 'Basé au Maroc' : 'Based in Morocco'}</span></span></p>
        <h1 class="hero__h1" id="hero-h1">{h1a}{h1b && <Fragment> <span class="serif serif--line">{h1b}</span></Fragment>}</h1>
        <p class="hero__status" set:html={rich(status.employers[lang])} />
        <div class="hero__btns">
          <a class="btn btn--primary" href="#work">{t(lang, 'cta.viewWork')} <span class="btn__arrow" aria-hidden="true">→</span></a>
          {cv.href && <a class="btn" href={cv.href}>{t(lang, 'cta.downloadCv')}</a>}
        </div>
      </div>
    </div>

    <div class="hero__hud">
      <dl class="hero__stats">
        {hero.stats.map((s) => (
          <div><dt>{s.value[lang]}</dt><dd>{s.label[lang]}</dd></div>
        ))}
      </dl>
      <a class="hero__cue meta" href="#work"><span class="hero__cue-line" aria-hidden="true"></span>{fr ? 'Défiler' : 'Scroll'}</a>
      <div class="hero__time">
        <p class="meta">{fr ? 'Maroc' : 'Morocco'} · <span data-tz>GMT+1</span></p>
        <p class="hero__clock" data-clock hidden aria-hidden="true"></p>
        <a class="hero__feature" href={lp(lang, '/work/aneuxplain')}>{fr ? 'Mon projet de fin d’études' : 'My capstone project'}: <span>AneuXplain</span> <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </div>
</section>

<style>
  /* Centred portrait above centred copy: the face stays clear of the headline. */
  .hero { position: relative; overflow: clip; isolation: isolate; padding-top: var(--header-h); background: var(--bg); }
  .hero__inner { display: grid; grid-template-columns: minmax(0, 1fr); grid-template-rows: 1fr auto; min-height: calc(100svh - var(--header-h)); }
  .hero__stage { position: relative; isolation: isolate; display: grid; justify-items: center; align-content: center; padding-block: var(--s-5) var(--s-7); }
  .hero__portrait { width: min(56svh, 38rem); max-width: 100%; min-width: 0; margin-bottom: var(--s-3); pointer-events: none; }
  .hero__portrait picture { display: block; width: 100%; aspect-ratio: 1.35; overflow: hidden; }
  .hero__portrait img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: center top; filter: grayscale(1) sepia(0.42) brightness(0.65) contrast(1.04); mask-image: linear-gradient(to bottom, var(--mask-solid) 58%, transparent 100%); }
  .hero__copy { position: relative; display: grid; justify-items: center; gap: var(--s-4); text-align: center; min-width: 0; width: 100%; }
  .hero__role { display: flex; flex-wrap: wrap; justify-content: center; gap: var(--s-2) 0; color: var(--text-muted); max-width: 100%; }
  .hero__name { color: var(--heading); }
  .hero__phrases { display: inline-flex; flex-wrap: wrap; justify-content: center; }
  .hero__phrases > span { white-space: nowrap; }
  .hero__sep { margin-inline: 0.7em; }
  .hero__h1 { font-size: var(--fs-h1-hero); font-weight: var(--fw-thin); line-height: 1.05; letter-spacing: var(--track-display); max-width: none; text-wrap: balance; }
  .hero__h1 .serif { white-space: normal; margin-top: 0.12em; }
  .hero__status { max-width: 76ch; color: var(--text-muted); text-wrap: balance; }
  .hero__btns { display: flex; flex-wrap: wrap; justify-content: center; gap: var(--s-3); margin-top: var(--s-2); }
  @media (max-width: 599px) {
    .hero__portrait { width: min(80vw, 26rem); }
    .hero__role { flex-direction: column; align-items: center; font-size: var(--fs-cap); letter-spacing: 0.12em; }
    .hero__role > .hero__sep { display: none; }
    .hero__sep { margin-inline: 0.5em; }
    .hero__h1 { max-width: 18ch; }
  }

  /* HUD row: stats | scroll cue | Morocco clock, over a hairline */
  /* Top-aligned: the stats sit right under the hairline, so they stay on the first screen even when the clock
     column below them is cut off on a short screen. */
  .hero__hud {
    display: grid; grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr); align-items: start; gap: var(--s-5);
    border-top: 1px solid var(--line); padding-block: var(--s-4); min-width: 0;
  }
  .hero__stats { min-width: 0; }
  /* Short screens (e.g. 1920x1080 at 125% scaling = 1536x730): slightly tighter copy. */
  @media (min-width: 600px) and (max-height: 820px) {
    .hero__portrait { width: min(40svh, 26rem); }
    .hero__stage { padding-bottom: var(--s-5); }
    .hero__copy { gap: var(--s-2); padding-bottom: var(--s-3); }
    .hero__hud { padding-block: var(--s-3); }
  }
  .hero__stats { display: flex; flex-wrap: wrap; gap: var(--s-4) var(--s-6); }
  .hero__stats div { display: grid; gap: var(--s-1); }
  .hero__stats dt { font-size: var(--fs-stat); font-weight: var(--fw-thin); line-height: 1; color: var(--heading); font-variant-numeric: tabular-nums; }
  .hero__stats dd {
    font-size: var(--fs-cap); letter-spacing: var(--track-label); text-transform: uppercase;
    color: var(--text-muted); line-height: 1.5; max-width: 24ch;
  }
  .hero__cue { display: grid; justify-items: center; gap: var(--s-2); min-height: 44px; text-decoration: none; color: var(--text-muted); }
  .hero__cue:hover { color: var(--text); }
  .hero__cue-line { display: block; width: 1px; height: 40px; background: linear-gradient(var(--accent), transparent); transform-origin: top; }
  .fx-on .hero__cue-line { animation: cue 2.4s var(--ease-out) infinite; }
  @keyframes cue {
    0% { transform: scaleY(0); transform-origin: top; }
    50% { transform: scaleY(1); transform-origin: top; }
    51% { transform-origin: bottom; }
    100% { transform: scaleY(0); transform-origin: bottom; }
  }
  .hero__time { display: grid; justify-items: end; gap: var(--s-1); text-align: end; }
  .hero__time .meta { color: var(--text-muted); }
  .hero__clock { font-size: var(--fs-lg); font-weight: var(--fw-light); letter-spacing: 0.04em; color: var(--text); font-variant-numeric: tabular-nums; }
  .hero__feature {
    display: inline-flex; align-items: center; gap: 0.35em; min-height: 44px;
    font-size: var(--fs-small); color: var(--text-muted); text-decoration: none;
  }
  .hero__feature span:first-child { color: var(--text); }
  .hero__feature span:last-child { color: var(--accent); }
  .hero__feature:hover span:first-child { text-decoration: underline; text-decoration-color: var(--accent); }

  @media (max-width: 819px) {
    .hero__hud { grid-template-columns: minmax(0, 1fr); gap: var(--s-4); }
    /* Phones: the three stats stay on one row, so the row is visible on the first screen. */
    .hero__stats { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--s-3); }
    .hero__stats dt { font-size: var(--fs-stat-sm); }
    .hero__cue { display: none; }
    .hero__time { justify-items: start; text-align: start; }
  }
</style>
