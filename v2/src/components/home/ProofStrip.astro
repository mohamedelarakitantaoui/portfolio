---
// Static proof row (v3): institutions and the venue as mono wordmarks. No logos, no motion.
import { proof } from '../../data/site';
import { starSvg } from '../../lib/rich';
import type { Lang } from '../../i18n/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;
---
<section class="proof" aria-label={lang === 'fr' ? 'Où j’ai étudié, travaillé et publié' : 'Where I studied, worked and published'}>
  <div class="wrap">
    <ul class="proof__list">
      {proof.map((p, i) => (
        <li>{i > 0 && <span class="proof__sep" aria-hidden="true" set:html={starSvg()} />}<span>{p}</span></li>
      ))}
    </ul>
  </div>
</section>

<style>
  .proof { border-block: 1px solid var(--line); background: var(--bg-band); }
  .proof__list { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-2) 0; list-style: none; padding-block: var(--s-5); }
  .proof__list li {
    display: inline-flex; align-items: center; font-family: var(--font-mono); font-size: clamp(0.75rem, 1.1vw, 0.9375rem);
    letter-spacing: 0.08em; text-transform: uppercase; white-space: nowrap; color: var(--text-muted);
  }
  .proof__sep { display: inline-flex; margin-inline: var(--s-4); }
  .proof__sep :global(.star-glyph) { width: 11px; height: 11px; }
</style>
