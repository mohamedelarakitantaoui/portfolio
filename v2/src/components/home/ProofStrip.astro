---
// Static proof row (v4): where I studied, worked and published, as plain text wordmarks. No logos, no motion.
import { proof } from '../../data/site';
import type { Lang } from '../../i18n/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;
---
<section class="proof" aria-label={lang === 'fr' ? 'Où j’ai étudié, travaillé et publié' : 'Where I studied, worked and published'}>
  <div class="wrap">
    <ul class="proof__list">
      {proof.map((p) => <li>{p}</li>)}
    </ul>
  </div>
</section>

<style>
  .proof { border-block: 1px solid var(--line); }
  .proof__list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); list-style: none; }
  .proof__list li {
    display: flex; align-items: center; justify-content: center; text-align: center; min-height: 88px; padding: var(--s-4);
    font-size: clamp(1rem, 0.9rem + 0.45vw, 1.375rem); font-weight: 600; letter-spacing: var(--track-h); line-height: 1.2;
    color: var(--text-muted);
  }
  .proof__list li:nth-child(odd) { border-inline-end: 1px solid var(--line); }
  .proof__list li:nth-child(-n + 2) { border-bottom: 1px solid var(--line); }
  @media (min-width: 900px) {
    .proof__list { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .proof__list li { min-height: 120px; }
    .proof__list li:nth-child(-n + 2) { border-bottom: 0; }
    .proof__list li:not(:last-child) { border-inline-end: 1px solid var(--line); }
  }
</style>
