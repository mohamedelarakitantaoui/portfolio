---
// Proof row (v4): where I studied, worked and published, as plain text wordmarks. No logos. Static here; on wide
// screens the effects loader turns it into a slow loop (src/scripts/effects/fx/proof-loop.ts).
import { proof } from '../../data/site';
import type { Lang } from '../../i18n/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;
---
<section class="proof" data-fx="proof-loop" aria-label={lang === 'fr' ? 'Où j’ai étudié, travaillé et publié' : 'Where I studied, worked and published'}>
  <div class="wrap">
    <ul class="proof__list">
      {proof.map((p) => <li>{p}</li>)}
    </ul>
  </div>
</section>

<style>
  .proof { border-block: 1px solid var(--line); }
  .proof__list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); list-style: none; }
  .proof__list li {
    display: flex; align-items: center; justify-content: center; text-align: center; min-height: 88px; padding: var(--s-4);
    font-size: clamp(1rem, 0.9rem + 0.45vw, 1.375rem); font-weight: var(--fw-light); letter-spacing: var(--track-h); line-height: 1.2;
    color: var(--text-muted);
  }
  .proof__list li:nth-child(odd) { border-inline-end: 1px solid var(--line); }
  .proof__list li:nth-child(-n + 2) { border-bottom: 1px solid var(--line); }
  @media (min-width: 900px) {
    .proof__list { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .proof__list li { min-height: 120px; }
    .proof__list li:nth-child(-n + 2) { border-bottom: 0; }
    .proof__list li:not(:last-child) { border-inline-end: 1px solid var(--line); }
  }
  /* Effect (src/scripts/effects/fx/proof-loop.ts): two copies of the list side by side, moved by transform. */
  .proof:global(.is-looping) { overflow: clip; }
  .proof:global(.is-looping) .wrap { max-width: none; padding-inline: 0; }
  .proof :global(.proof__track) { display: flex; width: max-content; will-change: transform; }
  .proof:global(.is-looping) .proof__list { display: flex; flex: none; }
  .proof:global(.is-looping) .proof__list li { width: max(25vw, 320px); white-space: nowrap; border-bottom: 0; border-inline-end: 1px solid var(--line); }
</style>
