---
// v5 Work: the heading on the left, the intro on the right, then the featured projects as hairline rows.
import { getCollection } from 'astro:content';
import ProjectRow from '../ProjectRow.astro';
import { type Lang, lp, t } from '../../i18n/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;
const projects = (await getCollection('projects', (p) => p.data.lang === lang && p.data.tier === 'featured')).sort((a, b) => a.data.order - b.data.order);
const fr = lang === 'fr';
---
<section class="work section" aria-labelledby="work-h2" id="work" tabindex="-1">
  <div class="wrap">
    <div class="work__head">
      <div>
        <p class="label">01 / {fr ? 'Une sélection' : 'Selected work'}</p>
        <h2 class="h2" id="work-h2">{fr ? 'Des modèles.' : 'Models.'} <span class="serif serif--line">{fr ? 'Et leur application.' : 'And what they become.'}</span></h2>
      </div>
      <div class="work__intro">
        <p>{fr
          ? 'AneuXplain est mon projet de fin d’études et celui dont je suis le plus fier. L’article a été accepté à ICOA 2026 ; j’attends sa publication.'
          : 'AneuXplain is my capstone and the project I’m most proud of. The paper was accepted at ICOA 2026; I’m waiting for its publication.'}</p>
        <a class="link" href={lp(lang, '/work')}>{t(lang, 'cta.allProjects')}</a>
      </div>
    </div>
    <ol class="work__rows">
      {projects.map((p) => <ProjectRow project={p} lang={lang} />)}
    </ol>
  </div>
</section>

<style>
  .work:focus { outline: none; }
  .work__head { display: grid; gap: var(--s-5); align-items: end; margin-bottom: var(--s-7); }
  .work__head .h2 { max-width: 17ch; }
  .work__intro p { max-width: 40ch; color: var(--text-muted); }
  .work__intro .link { margin-top: var(--s-3); }
  .work__rows { list-style: none; }
  @media (min-width: 900px) {
    .work__head { grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); gap: var(--s-8); }
    .work__intro { justify-self: end; }
  }
</style>
