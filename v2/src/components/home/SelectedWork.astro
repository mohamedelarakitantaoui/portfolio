---
import { getCollection } from 'astro:content';
import ProjectCard from '../ProjectCard.astro';
import MoreProjects from '../MoreProjects.astro';
import { type Lang, lp, t } from '../../i18n/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;
const projects = (await getCollection('projects', (p) => p.data.lang === lang && p.data.tier === 'featured')).sort((a, b) => a.data.order - b.data.order);
const [first, ...rest] = projects;
const fr = lang === 'fr';
---
<section class="work section band" aria-labelledby="work-h2" id="work">
  <div class="wrap grid-12 work__grid">
    <div class="work__head">
      <div class="work__sticky">
        <p class="label">{fr ? 'Projets choisis' : 'Selected work'}</p>
        <h2 class="h2" id="work-h2" data-reveal-lines>{fr ? 'Trois projets, avec les chiffres.' : 'Three projects, with the numbers.'}</h2>
        <p class="work__sub">{fr ? 'Ce que j’ai construit, ce qui a changé, et mon point de départ.' : 'What I built, what changed, and what I started from.'}</p>
        <a class="btn" href={lp(lang, '/work')}>{t(lang, 'cta.allProjects')}<span class="arrow" aria-hidden="true">→</span></a>
      </div>
    </div>
    <div class="work__cards">
      <ProjectCard project={first} lang={lang} large />
      <div class="work__pair">
        {rest.map((p) => <ProjectCard project={p} lang={lang} />)}
      </div>
      <MoreProjects lang={lang} id="home-more" />
    </div>
  </div>
</section>

<style>
  .work__grid { row-gap: var(--s-7); }
  .work__sub { color: var(--text-muted); margin-block: var(--s-4) var(--s-5); max-width: 36ch; }
  .work__cards { display: grid; gap: var(--s-8); }
  .work__pair { display: grid; gap: var(--s-8); }
  @media (min-width: 768px) {
    .work__pair { grid-template-columns: 1fr 1fr; gap: var(--s-6); align-items: start; }
  }
  @media (min-width: 1024px) {
    .work__head { grid-column: 1 / span 4; }
    .work__cards { grid-column: 5 / -1; }
    .work__sticky { position: sticky; top: var(--s-9); }
  }
</style>
