---
import { getCollection } from 'astro:content';
import ProjectCard from '../ProjectCard.astro';
import { type Lang, lp, t } from '../../i18n/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;
const projects = (await getCollection('projects', (p) => p.data.lang === lang && p.data.tier === 'featured')).sort((a, b) => a.data.order - b.data.order);
const fr = lang === 'fr';
---
<section class="work section" aria-labelledby="work-h2" id="work" tabindex="-1">
  <div class="wrap">
    <div class="work__head">
      <div>
        <p class="label label--plain">01 / {fr ? 'Une sélection' : 'Selected work'}</p>
        <h2 class="h2" id="work-h2">{fr ? 'Des modèles.' : 'Models.'}<br /><span>{fr ? 'Et leur application.' : 'And what they become.'}</span></h2>
      </div>
      <div class="work__intro">
        <p>{fr
          ? 'AneuXplain est mon projet de fin d’études et celui dont je suis le plus fier. L’article a été accepté à ICOA 2026 ; j’attends sa publication.'
          : 'AneuXplain is my capstone and the project I’m most proud of. The paper was accepted at ICOA 2026; I’m waiting for its publication.'}</p>
        <a class="link" href={lp(lang, '/work')}>{t(lang, 'cta.allProjects')}</a>
      </div>
    </div>
    {projects[0] && <div class="work__feature"><ProjectCard project={projects[0]} lang={lang} featured /></div>}
    <div class="work__supporting">
      {projects.slice(1).map((p, i) => (
        <div class="work__project">
          <p class="work__index meta"><span>0{i + 2}</span><span>{p.data.key === 'dce-scraper' ? (fr ? 'Automatisation / Intelcia' : 'Automation / Intelcia') : (fr ? 'Football / Machine learning' : 'Football / Machine learning')}</span></p>
          <ProjectCard project={p} lang={lang} />
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .work:focus { outline: none; }
  .work__head { display: grid; gap: var(--s-6); align-items: end; margin-bottom: var(--s-8); }
  .work__head .h2 { max-width: 17ch; }
  .work__head .h2 span { color: var(--text-muted); }
  .work__intro p { max-width: 45ch; color: var(--text-muted); font-size: var(--fs-lede); }
  .work__intro .link { margin-top: var(--s-5); }
  .work__feature { padding-top: var(--s-6); border-top: 1px solid var(--accent-line); }
  .work__supporting { display: grid; gap: var(--s-8); margin-top: var(--s-9); }
  .work__index { display: flex; align-items: center; gap: var(--s-5); margin-bottom: var(--s-5); padding-block: var(--s-4); border-top: 1px solid var(--line); }
  .work__index > span:first-child { color: var(--accent); }
  @media (min-width: 1024px) {
    .work__head { grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); gap: var(--s-9); }
    .work__supporting { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: var(--s-8); }
    .work__project:last-child { padding-top: var(--s-9); }
  }
</style>
