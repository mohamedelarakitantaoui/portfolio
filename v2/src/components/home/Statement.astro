---
// Scroll-scrubbed statement: words start "unlit" and light up as you scroll (JS only).
// Without JS or with reduced motion, every word is fully lit.
import { statement } from '../../data/site';
import { starSvg } from '../../lib/rich';
import type { Lang } from '../../i18n/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;
const html = statement[lang]
  .split(/\s+/)
  .map((w) => (w === '✦' ? `<span class="w w--star">${starSvg()}</span>` : `<span class="w">${w.replace(/✦/g, starSvg())}</span>`))
  .join(' ');
---
<section class="statement section" aria-label={lang === 'fr' ? 'En bref' : 'In short'}>
  <div class="wrap">
    <p class="statement__text" data-statement set:html={html} />
  </div>
</section>

<style>
  .statement { padding-block: var(--s-9); }
  @media (min-width: 1024px) { .statement { padding-block: var(--s-10); } }
  .statement__text {
    font-family: var(--font-display); font-weight: 500; font-size: var(--fs-statement);
    letter-spacing: -0.03em; line-height: 1.15; max-width: 30ch; color: var(--text);
    font-variation-settings: 'opsz' 48;
  }
  @media (min-width: 1024px) { .statement__text { margin-inline-start: 16.66%; } }
  .statement__text :global(.w) { transition: color 0.2s linear; }
  .statement__text :global(.star-glyph) { width: 0.6em; height: 0.6em; vertical-align: 0.05em; }
  :global(html.motion-ok) .statement__text :global(.w:not(.is-lit)) { color: var(--bone-unlit); }
</style>
