---
// Two audiences, two doors (v5: two sharp --surface panels). Employers: CV + LinkedIn. Clients: services + email.
import { doors, person } from '../../data/site';
import { cvLink } from '../../lib/cv';
import { type Lang, lp, t } from '../../i18n/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;
const fr = lang === 'fr';
const cv = cvLink(lang);
const newTab = fr ? 'nouvel onglet' : 'opens in a new tab';
---
<section class="doors" aria-label={fr ? 'Travailler ensemble' : 'Work with me'}>
  <div class="wrap doors__grid">
    <div class="door" data-reveal>
      <p class="label">{fr ? 'Recruteurs' : 'Employers'}</p>
      <h2 class="h2 door__title">{doors.employers.title[lang]}</h2>
      <p class="door__text">{doors.employers.text[lang]}</p>
      <div class="door__ctas">
        <a class="btn btn--primary" href={cv.href}>{t(lang, 'cta.downloadCv')} <span class="btn__arrow" aria-hidden="true">→</span></a>
        <a class="link" href={person.linkedin} target="_blank" rel="me noopener">{t(lang, 'cta.linkedin')}<span class="sr-only"> ({newTab})</span></a>
      </div>
    </div>
    <div class="door" data-reveal>
      <p class="label">{fr ? 'Clients' : 'Clients'}</p>
      <h2 class="h2 door__title">{doors.clients.title[lang]}</h2>
      <p class="door__text">{doors.clients.text[lang]}</p>
      <div class="door__ctas">
        <a class="btn btn--primary" href={lp(lang, '/services')}>{t(lang, 'cta.packs')} <span class="btn__arrow" aria-hidden="true">→</span></a>
        <a class="link" href={`mailto:${person.email}?subject=${encodeURIComponent(fr ? 'Projet' : 'Project')}`}>{t(lang, 'cta.emailMe')}</a>
      </div>
    </div>
  </div>
</section>

<style>
  /* Same rhythm as every section: the panels' own inner padding (--door-pad) comes off the section padding, so the
     space between the previous section's text and these panels' text matches the other section boundaries. */
  .doors { --door-pad: var(--s-7); padding-block: calc(var(--section-y) - var(--door-pad)); }
  .doors__grid { display: grid; gap: var(--s-3); }
  .door {
    display: grid; gap: var(--s-5); align-content: start;
    padding: var(--door-pad) clamp(var(--s-5), 3vw, var(--door-pad));
    background: var(--surface); border: 1px solid var(--line);
    transition: border-color var(--dur-btn) var(--ease-out);
  }
  .door:hover { border-color: var(--accent-line); }
  .door .label { margin-bottom: 0; }
  .door__title { max-width: 14ch; font-size: clamp(1.875rem, 3vw, 2.625rem); line-height: 1.05; }
  .door__text { color: var(--text-muted); max-width: 52ch; }
  .door__ctas { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-3) var(--s-5); margin-top: var(--s-2); }
  @media (min-width: 820px) { .doors__grid { grid-template-columns: 1fr 1fr; } }
</style>
