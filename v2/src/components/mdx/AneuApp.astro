---
// AneuXplain chapter 03: the real app. A muted loop, the full walkthrough in a dialog, and five stills
// that open the walkthrough at their timestamp. Without JS the links still open the MP4 at #t=<seconds>.
import { Image } from 'astro:assets';
import { langFromUrl } from '../../i18n/ui';
import s01 from '../../assets/aneuxplain/01-load-dicom.webp';
import s02 from '../../assets/aneuxplain/02-3d-reconstruction.webp';
import s03 from '../../assets/aneuxplain/03-risk-score.webp';
import s04 from '../../assets/aneuxplain/04-heatmap.webp';
import s05 from '../../assets/aneuxplain/05-measurements.webp';

const fr = langFromUrl(Astro.url) === 'fr';
const dir = '/media/aneuxplain';
const walk = `${dir}/aneuxplain-walkthrough.mp4`;
const poster = `${dir}/aneuxplain-poster.webp`;
const stills = [
  { img: s01, t: 27, cap: fr ? 'Charger le scanner' : 'Load the scan', alt: fr ? 'Visionneuse DICOM : coupe 71 sur 140 d’une IRM cérébrale, segmentation en cours' : 'DICOM viewer: slice 71 of 140 of a brain MRA, segmentation running' },
  { img: s02, t: 57, cap: fr ? 'Reconstruire les vaisseaux en 3D' : 'Rebuild the vessels in 3D', alt: fr ? 'Arbre vasculaire reconstruit en 3D' : 'Vessel tree reconstructed in 3D' },
  { img: s03, t: 127, cap: fr ? 'Évaluer le risque de rupture' : 'Score rupture risk', alt: fr ? 'Probabilité de rupture de 67 %, panneau morphologique, badge « Out of distribution » en haut à droite' : '67% rupture probability next to the morphology panel, with an “Out of distribution” badge top right' },
  { img: s04, t: 98, cap: fr ? 'Montrer où se situe le risque' : 'Show where the risk is', alt: fr ? 'Carte de chaleur de sensibilité au risque sur le vaisseau' : 'Risk-sensitivity heatmap painted on the vessel' },
  { img: s05, t: 115, cap: fr ? 'Mesurer l’anévrisme' : 'Measure the aneurysm', alt: fr ? 'Dôme mesuré sur le maillage filaire, volume 161,3 mm³' : 'Dome measured on the wireframe, volume 161.3 mm³' },
];
const mmss = (t: number) => `${Math.floor(t / 60)}:${String(t % 60).padStart(2, '0')}`;
---
<figure class="app">
  <div class="app__frame">
    <video class="app__loop" data-loop muted loop playsinline preload="none" poster={poster} width="1280" height="690"
      aria-label={fr ? 'Boucle muette de 24 s : reconstruction 3D, score de risque, carte de chaleur, mesures' : 'Silent 24 s loop: 3D reconstruction, risk score, heatmap, measurements'}>
      <source src={`${dir}/aneuxplain-loop.webm`} type="video/webm" />
      <source src={`${dir}/aneuxplain-loop.mp4`} type="video/mp4" />
    </video>
    <button class="app__toggle mono" type="button" data-loop-toggle hidden
      data-play={fr ? 'Lire la boucle' : 'Play loop'} data-pause={fr ? 'Pause' : 'Pause'}>
      <svg class="app__icon" viewBox="0 0 16 16" aria-hidden="true"><path class="app__icon-play" d="M4 2.5v11l9.5-5.5z" /><path class="app__icon-pause" d="M3.5 2.5h3v11h-3zM9.5 2.5h3v11h-3z" /></svg>
      <span data-loop-label>{fr ? 'Lire la boucle' : 'Play loop'}</span>
    </button>
  </div>
  <figcaption class="app__cap">
    <span>{fr ? 'L’application réelle, sur un scanner public (Lausanne TOF-MRA, CC0).' : 'The real app, on a public scan (Lausanne TOF-MRA, CC0).'}</span>
    <a class="btn btn--sm" href={walk} data-walk="0">
      {fr ? 'Voir la démonstration complète (2 min 29)' : 'Watch the full walkthrough (2:29)'}
    </a>
  </figcaption>
</figure>

<ol class="strip" aria-label={fr ? 'Les étapes, en images' : 'The steps, in stills'}>
  {stills.map((s, i) => (
    <li>
      <a class="strip__item" href={`${walk}#t=${s.t}`} data-walk={s.t}>
        <Image src={s.img} alt={s.alt} widths={[400, 640, 960]} sizes="(min-width: 1024px) 14vw, (min-width: 640px) 18vw, 100vw" format="webp" class="strip__img" loading="lazy" decoding="async" />
        <span class="strip__cap mono">
          <span><span class="strip__n">{String(i + 1).padStart(2, '0')}</span> {s.cap}</span>
          <span class="strip__t">{mmss(s.t)}</span>
        </span>
      </a>
    </li>
  ))}
</ol>

<dialog class="walk" data-walk-dialog aria-labelledby="walk-title" data-lenis-prevent>
  <div class="walk__head">
    <p class="walk__title mono" id="walk-title">{fr ? 'AneuXplain · démonstration complète, 2 min 29, sans son' : 'AneuXplain · full walkthrough, 2:29, no sound'}</p>
    <button class="walk__close" type="button" data-walk-close aria-label={fr ? 'Fermer' : 'Close'}>
      <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 3l10 10M13 3L3 13" /></svg>
    </button>
  </div>
  <video class="walk__video" controls playsinline preload="none" poster={poster} width="1280" height="690" data-src={walk}>
    <source src={walk} type="video/mp4" />
  </video>
</dialog>

<style>
  .app, .strip { width: 100%; width: 100cqi; }
  .app { margin-block: 0 var(--s-5); }
  .app__frame { position: relative; }
  .app__loop {
    display: block; width: 100%; height: auto; aspect-ratio: 1280 / 690;
    background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-lg);
  }
  .app__toggle {
    position: absolute; inset-inline-start: var(--s-3); inset-block-end: var(--s-3);
    display: inline-flex; align-items: center; gap: var(--s-2); min-height: 44px; padding: 0 var(--s-4);
    border: 1px solid var(--line-input); border-radius: var(--r-pill);
    background: var(--bg); color: var(--text); font-size: 0.75rem; cursor: pointer;
  }
  .app__toggle:hover { border-color: var(--text); }
  .app__icon { width: 12px; height: 12px; fill: currentColor; }
  .app__toggle .app__icon-pause, .app__toggle[aria-pressed='true'] .app__icon-play { display: none; }
  .app__toggle[aria-pressed='true'] .app__icon-pause { display: inline; }
  /* Reduced motion: poster + one big play button, no autoplay */
  .app__toggle.is-big {
    inset: 50% auto auto 50%; transform: translate(-50%, -50%);
    min-height: 64px; padding: 0 var(--s-6); font-size: 0.875rem;
    background: var(--accent-fill); color: var(--accent-fill-ink); border-color: transparent;
  }
  .app__toggle.is-big .app__icon { width: 16px; height: 16px; }
  .app__cap {
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--s-3);
    margin-top: var(--s-3); color: var(--text-muted); font-size: var(--fs-small);
  }
  .app__cap .btn { white-space: normal; text-align: start; line-height: 1.3; padding-block: var(--s-2); }

  .strip { list-style: none; display: grid; gap: var(--s-4); margin-block: var(--s-5) 0; }
  @media (min-width: 640px) { .strip { grid-template-columns: repeat(5, minmax(0, 1fr)); gap: var(--s-3); } }
  .strip__item { display: grid; gap: var(--s-2); text-decoration: none; color: var(--text); }
  .strip__img {
    width: 100%; height: auto; aspect-ratio: 1600 / 862; object-fit: cover;
    border: 1px solid var(--line); border-radius: calc(var(--r-lg) / 2); background: var(--surface);
    transition: border-color var(--dur-2) var(--ease-out), transform var(--dur-2) var(--ease-out);
  }
  .strip__item:hover .strip__img { border-color: var(--accent); transform: translateY(-2px); }
  .strip__cap { display: flex; justify-content: space-between; align-items: baseline; gap: var(--s-2); font-size: 0.75rem; line-height: 1.4; color: var(--text-muted); }
  .strip__item:hover .strip__cap { color: var(--text); }
  .strip__n { color: var(--accent); }
  .strip__t { color: var(--text-quiet); flex: none; }
  @media (min-width: 640px) { .strip__cap { flex-direction: column; gap: 0; } }

  .walk {
    width: min(1100px, calc(100% - 32px)); max-height: calc(100% - 32px); margin: auto;
    padding: 0; border: 1px solid var(--line-input); border-radius: var(--r-lg);
    background: var(--surface); color: var(--text); box-shadow: 0 8px 32px rgba(0, 0, 0, 0.45);
  }
  .walk::backdrop { background: rgba(17, 17, 17, 0.75); }
  .walk__head { display: flex; align-items: center; justify-content: space-between; gap: var(--s-3); padding: var(--s-2) var(--s-2) var(--s-2) var(--s-4); }
  .walk__title { font-size: 0.75rem; color: var(--text-muted); }
  .walk__close {
    display: inline-grid; place-items: center; width: 44px; height: 44px; flex: none;
    border: 0; border-radius: var(--r-pill); background: transparent; color: var(--text); cursor: pointer;
  }
  .walk__close:hover { background: var(--bg-band); }
  .walk__close svg { width: 16px; height: 16px; stroke: currentColor; stroke-width: 1.75; stroke-linecap: round; }
  .walk__video { display: block; width: 100%; height: auto; aspect-ratio: 1280 / 690; background: #000; }
</style>
