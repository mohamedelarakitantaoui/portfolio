---
// One case-study chapter, a numbered hairline section: the big thin number and the label on the left, an h2 that is
// a claim and the body on the right (stacked on phones).
// In production a chapter whose title or body is only TODO markers is omitted entirely.
import { rich, shows } from '../../lib/rich';
import { langFromUrl, t } from '../../i18n/ui';
interface Props { n: string; label: string; title: string }
const { n, label, title } = Astro.props;
const lang = langFromUrl(Astro.url);
const body = await Astro.slots.render('default');
const hasBody = body.replace(/<[^>]+>/g, '').trim() !== '' || /<(img|svg|video|figure|picture)\b/.test(body);
const render = shows(title) && (import.meta.env.DEV || hasBody);
---
{render && (
  <section class="chapter" aria-labelledby={`ch-${n}`}>
    <div class="chapter__side">
      <p class="chapter__n" aria-hidden="true">{n}</p>
      <p class="chapter__label meta"><span class="sr-only">{t(lang, 'chapter')} {n} · </span>{label}</p>
    </div>
    <div class="chapter__main">
      <h2 class="chapter__title" id={`ch-${n}`} data-reveal-lines set:html={rich(title)} />
      <div class="chapter__body prose" set:html={body} />
    </div>
  </section>
)}

<style>
  .chapter {
    display: grid; gap: var(--s-4) var(--grid-gap); padding-block: var(--s-8); border-top: 1px solid var(--line);
    scroll-margin-top: var(--header-h);
  }
  .chapter:first-of-type { border-top: 0; }
  .chapter__side { display: flex; align-items: baseline; gap: var(--s-4); align-content: start; }
  .chapter__n {
    font-size: var(--fs-index); font-weight: var(--fw-thin); letter-spacing: var(--track-h); line-height: 0.9;
    color: var(--text-quiet); font-variant-numeric: tabular-nums;
  }
  .chapter__label { color: var(--accent); }
  .chapter__main { min-width: 0; container-type: inline-size; }
  .chapter__title {
    font-size: clamp(2rem, 1.2rem + 2vw, 3.25rem);
    font-weight: var(--fw-thin); letter-spacing: var(--track-h); line-height: 1.08; max-width: 22ch;
    margin-bottom: var(--s-5); text-wrap: balance;
  }
  .chapter__body { color: var(--text-muted); }
  .chapter__body :global(ol:not([class])) { padding-inline-start: 1.3em; display: grid; gap: var(--s-2); margin-top: var(--s-4); }
  .chapter__body :global(ol:not([class]) li::marker) { color: var(--accent); font-family: var(--font-body); font-size: var(--fs-marker); }
  .chapter__body :global(ul:not([class]) li) { max-width: var(--measure); }
  @media (min-width: 1024px) {
    .chapter { grid-template-columns: minmax(0, 3fr) minmax(0, 9fr); padding-block: var(--s-9); }
    .chapter__side { flex-direction: column; gap: var(--s-3); position: sticky; top: calc(var(--header-h) + var(--s-6)); align-self: start; }
  }
</style>
