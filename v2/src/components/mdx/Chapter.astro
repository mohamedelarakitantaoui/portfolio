---
import { rich } from '../../lib/rich';
import { langFromUrl, t } from '../../i18n/ui';
interface Props { n: string; label: string; title: string }
const { n, label, title } = Astro.props;
const lang = langFromUrl(Astro.url);
---
<section class="chapter" aria-labelledby={`ch-${n}`}>
  <p class="chapter__label mono"><span class="chapter__n">{t(lang, 'chapter')} {n}</span><span aria-hidden="true">·</span><span>{label}</span></p>
  <h2 class="chapter__title" id={`ch-${n}`} data-reveal-lines set:html={rich(title)} />
  <div class="chapter__body prose"><slot /></div>
</section>

<style>
  .chapter { padding-block: var(--s-7); border-top: 1px solid var(--line); }
  .chapter:first-of-type { border-top: 0; padding-top: 0; }
  .chapter__label { display: flex; gap: var(--s-2); color: var(--text-quiet); margin-bottom: var(--s-4); }
  .chapter__n { color: var(--accent); }
  .chapter__title {
    font-family: var(--font-display); font-size: clamp(1.75rem, 3.2vw, 2.75rem);
    font-weight: 600; letter-spacing: -0.04em; line-height: 1.02; max-width: 22ch;
    margin-bottom: var(--s-5); text-wrap: balance;
  }
  .chapter__body { color: var(--text-muted); }
  .chapter__body :global(ol) { padding-inline-start: 1.3em; display: grid; gap: var(--s-2); margin-top: var(--s-4); }
  .chapter__body :global(ol li::marker) { color: var(--accent); font-family: var(--font-mono); font-size: 0.85em; }
</style>
