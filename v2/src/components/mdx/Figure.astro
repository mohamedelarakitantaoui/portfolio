---
// One real image inside a chapter: a screenshot or a chart plotted from logged numbers. Never an illustration.
// `img` is imported in the MDX file from src/assets/, so Astro sizes it and serves WebP.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { rich } from '../../lib/rich';
interface Props { img: ImageMetadata; alt: string; caption: string; light?: boolean }
const { img, alt, caption, light = false } = Astro.props;
---
<figure class="fig">
  <Image src={img} alt={alt} widths={[480, 760, 1140, 1520].filter((w) => w <= img.width)} sizes="(min-width: 1024px) 54vw, 100vw" format="webp" loading="lazy" decoding="async" class:list={['fig__img', { 'fig__img--light': light }]} />
  <figcaption class="fig__cap" set:html={rich(caption)} />
</figure>

<style>
  .fig { margin-block: var(--s-6); }
  .fig__img { display: block; width: 100%; height: auto; border: 1px solid var(--line); border-radius: var(--r-img); background: var(--surface); }
  /* Light screenshots (Kaggle pages) get a quieter frame so they don't glare against the dark page. */
  .fig__img--light { border-color: var(--line-strong); }
  .fig__cap { margin-top: var(--s-3); color: var(--text-muted); font-size: var(--fs-small); line-height: 1.45; max-width: var(--measure); }
</style>
