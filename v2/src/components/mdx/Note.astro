<p class="note"><span class="note__dot" aria-hidden="true"></span><span><slot /></span></p>

<style>
  .note {
    display: flex; align-items: center; gap: var(--s-3); margin-bottom: var(--s-7);
    padding: var(--s-3) var(--s-4); border: 1px solid var(--line-strong); border-radius: var(--r-pill);
    width: fit-content; max-width: 100%; font-size: var(--fs-label); font-weight: var(--fw-regular);
    letter-spacing: var(--track-label); text-transform: uppercase; color: var(--heading);
  }
  .note__dot { flex: none; width: 6px; height: 6px; background: var(--accent); }
</style>
