---
interface Props { items: [string, string, string][] }
const { items } = Astro.props;
---
<ol class="rows nrows">
  {items.map(([n, name, text]) => (
    <li>
      <span class="nrows__n meta">[{n}]</span>
      <span class="nrows__name">{name}</span>
      <span class="nrows__text">{text}</span>
    </li>
  ))}
</ol>

<style>
  .nrows { margin-top: var(--s-6); padding: 0; }
  .nrows li {
    display: grid; grid-template-columns: 3.2rem 1fr; gap: var(--s-1) var(--s-4);
    padding-block: var(--s-4); padding-inline-start: 0;
  }
  .nrows li::before { display: none; }
  @media (min-width: 900px) { .nrows li { grid-template-columns: 3.2rem minmax(0, 15rem) 1fr; align-items: baseline; } }
  .nrows__n { color: var(--accent); }
  .nrows__name { font-family: var(--font-body); font-size: var(--fs-small); color: var(--text); overflow-wrap: anywhere; }
  .nrows__text { grid-column: 2; color: var(--text-muted); }
  @media (min-width: 900px) { .nrows__text { grid-column: 3; } }
</style>
