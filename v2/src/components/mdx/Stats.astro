---
import { rich } from '../../lib/rich';
interface Props { items: { value: string; caption: string }[] }
const { items } = Astro.props;
---
<dl class="stats" style={`--cols:${Math.min(items.length, 4)}`}>
  {items.map((s) => (
    <div class="stat">
      <dt class="stat__value">{s.value}</dt>
      <dd class="stat__caption" set:html={rich(s.caption)} />
    </div>
  ))}
</dl>

<style>
  .stats { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--s-5) var(--s-5); margin-block: var(--s-5) var(--s-6); }
  @media (min-width: 768px) { .stats { grid-template-columns: repeat(var(--cols), minmax(0, 1fr)); } }
  .stat { border-top: 1px solid var(--line-strong); padding-top: var(--s-3); }
  .stat__value {
    font-weight: var(--fw-thin); letter-spacing: var(--track-h); line-height: 1; color: var(--heading);
    font-size: clamp(1.5rem, 3vw, 2.5rem); color: var(--text); text-wrap: balance;
  }
  .stat__caption { margin-top: var(--s-2); font-size: var(--fs-small); color: var(--text-muted); line-height: 1.4; }
</style>
