---
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/base.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CommandPalette from '../components/CommandPalette.astro';
import jost from '../assets/fonts/jost-wght-subset.woff2?url';
import { type Lang, swapLangPath, t } from '../i18n/ui';
import { person } from '../data/site';
import { plain } from '../lib/rich';
import { stripBase, withBase } from '../lib/base';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  ogKey: string;
  bodyClass?: string;
  noindex?: boolean;
}
const { lang, title, description, ogKey, bodyClass = '', noindex = false } = Astro.props;

const site = Astro.site ?? new URL('https://example.com');
// `path` is site-relative (no base); every absolute URL below adds the base back.
const path = stripBase(Astro.url.pathname).replace(/\/$/, '') || '/';
const canonical = new URL(withBase(path), site).href;
const isNotFound = path === '/404';
const enPath = isNotFound ? withBase('/') : swapLangPath(path, 'en');
const frPath = isNotFound ? withBase('/fr') : swapLangPath(path, 'fr');
const ogImage = new URL(withBase(`/og/${ogKey}-${lang}.png`), site).href;
const fullTitle = title.length > 60 ? title.slice(0, 59) + '…' : title;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: person.name,
    alternateName: person.legalName,
    jobTitle: person.jobTitle,
    email: `mailto:${person.email}`,
    url: new URL(withBase('/'), site).href,
    image: new URL(withBase('/og/home-en.png'), site).href,
    address: { '@type': 'PostalAddress', addressCountry: 'MA' },
    alumniOf: [
      { '@type': 'CollegeOrUniversity', name: 'Al Akhawayn University' },
      { '@type': 'CollegeOrUniversity', name: 'Boğaziçi University' },
    ],
    knowsLanguage: ['en', 'fr', 'ar'],
    knowsAbout: ['Python automation', 'Web scraping', 'Microservices', 'Explainable AI', 'PointNet', 'Expected goals (xG)', 'LightGBM', 'React', 'FastAPI', 'Docker', 'Kubernetes'],
    sameAs: [person.linkedin, person.github],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: person.name,
    url: new URL(withBase('/'), site).href,
    inLanguage: ['en', 'fr'],
  },
];
---
<!doctype html>
<html lang={lang} dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={plain(description).slice(0, 155)} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={new URL(enPath, site).href} />
    <link rel="alternate" hreflang="fr" href={new URL(frPath, site).href} />
    <link rel="alternate" hreflang="x-default" href={new URL(enPath, site).href} />
    <meta name="theme-color" content="#070605" />
    <link rel="preload" href={jost} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <link rel="icon" href={withBase('/favicon-32.png')} sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />
    <link rel="sitemap" href={withBase('/sitemap-index.xml')} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={person.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={plain(description).slice(0, 155)} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={lang === 'fr' ? 'fr_FR' : 'en_US'} />
    <meta property="og:locale:alternate" content={lang === 'fr' ? 'en_US' : 'fr_FR'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={plain(description).slice(0, 155)} />
    <meta name="twitter:image" content={ogImage} />

    <script is:inline>
      // Before paint: a JS flag only. No preloader, no theme switch: the first screen is static HTML.
      document.documentElement.classList.add('js');
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main">{t(lang, 'skip')}</a>
    <Header lang={lang} enPath={enPath} frPath={frPath} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer lang={lang} enPath={enPath} frPath={frPath} />
    <CommandPalette lang={lang} enPath={enPath} frPath={frPath} />
    <script>
      import '../scripts/main';
    </script>
  </body>
</html>

<style is:global>
  main:focus { outline: none; }
</style>
