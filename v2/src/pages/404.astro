---
import Base from '../layouts/Base.astro';
import Star from '../components/Star.astro';
---
<Base lang="en" title="Not on the map · Mamoun Tantaoui El Araki" description="This page doesn't exist. It may have moved when the site was rebuilt." ogKey="home" noindex>
  <section class="nf wrap">
    <Star class="nf__star" />
    <p class="label">404</p>
    <h1 class="h1 nf__h1">Not on the map.</h1>
    <p class="lede">That page doesn't exist; it may have moved when the site was rebuilt.</p>
    <p class="lede nf__fr" lang="fr">Cette page n’existe pas ; elle a peut-être bougé lors de la refonte du site.</p>
    <div class="nf__links">
      <a class="btn btn--primary" href="/">Home</a>
      <a class="btn" href="/work">Work</a>
      <a class="btn" href="/contact">Contact</a>
      <a class="btn" href="/fr" lang="fr">Accueil (FR)</a>
    </div>
  </section>
</Base>

<style>
  .nf { min-height: 100svh; display: grid; align-content: center; justify-items: start; padding-block: calc(var(--header-h) + var(--s-7)) var(--s-9); position: relative; }
  .nf :global(.nf__star) { width: clamp(120px, 22vw, 260px); height: auto; color: var(--accent-wall); margin-bottom: var(--s-6); animation: spin404 40s linear infinite; }
  @keyframes spin404 { to { transform: rotate(1turn); } }
  .nf__h1 { max-width: 12ch; }
  .nf__fr { margin-top: var(--s-3); }
  .nf__links { display: flex; flex-wrap: wrap; gap: var(--s-3); margin-top: var(--s-6); }
</style>
