---
import Base from '../layouts/Base.astro';
import { withBase } from '../lib/base';
---
<Base lang="en" title="Page not found · Mamoun El Araki" description="This page doesn't exist. It may have moved when the site was rebuilt." ogKey="home" noindex>
  <section class="nf">
    <div class="wrap">
      <p class="nf__code" aria-hidden="true" data-code="404"></p>
      <p class="label">404</p>
      <h1 class="h1 nf__h1">Page not found.</h1>
      <p class="lede">That page doesn't exist; it may have moved when the site was rebuilt.</p>
      <p class="lede nf__fr" lang="fr">Cette page n’existe pas ; elle a peut-être bougé lors de la refonte du site.</p>
      <div class="nf__links">
        <a class="btn btn--primary" href={withBase('/')}>Home</a>
        <a class="link" href={withBase('/work')}>Work</a>
        <a class="link" href={withBase('/contact')}>Contact</a>
        <a class="link" href={withBase('/fr')} lang="fr">Accueil (FR)</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .nf { min-height: 100svh; display: grid; align-content: center; background: var(--bg-band); padding-block: calc(var(--header-h) + var(--s-7)) var(--s-9); }
  .nf__code::before { content: attr(data-code); }
  .nf__code { font-size: clamp(6rem, 20vw, 16rem); font-weight: var(--fw-thin); letter-spacing: var(--track-display); line-height: 0.85; color: var(--line-strong); margin-bottom: var(--s-6); }
  .nf__h1 { max-width: 12ch; margin-bottom: var(--s-6); }
  .nf__fr { margin-top: var(--s-3); }
  .nf__links { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-3) var(--s-5); margin-top: var(--s-6); }
</style>
