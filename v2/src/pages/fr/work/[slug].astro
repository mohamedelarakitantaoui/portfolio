---
import CaseStudyView from '../../../views/CaseStudyView.astro';
import ProjectView from '../../../views/ProjectView.astro';
import { allProjects } from '../../../lib/projects';
// Every project has a page: its case study, or a short project page (caseStudy: false).
export async function getStaticPaths() {
  return (await allProjects('fr')).map((project) => ({ params: { slug: project.data.key }, props: { project } }));
}
const { project } = Astro.props;
---
{project.data.caseStudy ? <CaseStudyView project={project} lang="fr" /> : <ProjectView project={project} lang="fr" />}
