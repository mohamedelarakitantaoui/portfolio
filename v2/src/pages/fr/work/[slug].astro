---
import { getCollection } from 'astro:content';
import CaseStudyView from '../../../views/CaseStudyView.astro';
export async function getStaticPaths() {
  const projects = await getCollection('projects', (p) => p.data.lang === 'fr' && p.data.caseStudy && (import.meta.env.DEV || !p.data.draft));
  // draft pages (eSaha) exist in `astro dev` only
  return projects.map((project) => ({ params: { slug: project.data.key }, props: { project } }));
}
const { project } = Astro.props;
---
<CaseStudyView project={project} lang="fr" />
