---
// About (v3): three short paragraphs (who, what I work on, how I work), the photo, Now, languages. No life story.
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import Rich from '../components/Rich.astro';
import portrait from '../assets/portrait-studio.png';
import { about, now, person, spoken } from '../data/site';
import { cvLink } from '../lib/cv';
import { type Lang, t } from '../i18n/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;
const fr = lang === 'fr';
const cv = cvLink(lang);
---
<Base
  lang={lang}
  title={fr ? `À propos · ${person.name}` : `About · ${person.name}`}
  description={fr
    ? 'Mamoun El Araki, ingénieur IA et logiciel au Maroc : informatique à Al Akhawayn et Boğaziçi, ML explicable, et le logiciel autour.'
    : 'Mamoun El Araki, AI and software engineer in Morocco: computer science at Al Akhawayn and Boğaziçi, explainable ML, and the software around it.'}
  ogKey="about"
>
  <PageIntro label={fr ? 'À propos' : 'About'} title={fr ? 'À propos' : 'About'} />

  <section class="section about" aria-label={fr ? 'Qui je suis' : 'Who I am'}>
    <div class="wrap grid-12 about__grid">
      <div class="about__text">
        <p>{about.who[lang]}</p>
        <p>{about.what[lang]}</p>
        <p>{about.how[lang]}</p>
        <div class="about__ctas">
          <a class="btn btn--primary" href={cv.href}>{t(lang, 'cta.downloadCv')}</a>
          <a class="link" href={person.linkedin} target="_blank" rel="noopener">LinkedIn<span class="sr-only"> ({fr ? 'nouvel onglet' : 'opens in a new tab'})</span></a>
        </div>
      </div>
      <figure class="about__photo">
        <Image src={portrait} alt={fr ? 'Mamoun El Araki, portrait en studio' : 'Mamoun El Araki, studio portrait'} widths={[360, 540, 720]} sizes="(min-width: 1024px) 400px, 80vw" format="webp" quality={72} loading="eager" />
      </figure>
    </div>
  </section>

  <section class="section band" aria-labelledby="about-now">
    <div class="wrap grid-12 about__grid">
      <div class="about__col">
        <p class="label">{fr ? 'Maintenant' : 'Now'}</p>
        <h2 class="h2" id="about-now">{fr ? 'Un modèle xG pour le football, et un modèle Kaggle pour le genou.' : 'A football xG model and a Kaggle knee model.'}</h2>
        <ul class="rows about__now">
          {now.inProgress.map((it) => <li><Rich text={it[lang]} /></li>)}
        </ul>
      </div>
      <div class="about__col about__langs">
        <p class="label">{fr ? 'Langues' : 'Languages'}</p>
        <h2 class="h2" id="about-langs">{fr ? 'Arabe, français, anglais.' : 'Arabic, French, English.'}</h2>
        <ul class="rows about__lang-list" aria-labelledby="about-langs">
          {spoken[lang].map((l) => <li>{l}</li>)}
        </ul>
      </div>
    </div>
  </section>
</Base>

<style>
  .about__grid { row-gap: var(--s-7); align-items: start; }
  .about__text { display: grid; gap: var(--s-4); font-size: var(--fs-lede); line-height: 1.55; }
  .about__text p:first-child { color: var(--text); }
  .about__text p + p { color: var(--text-muted); }
  .about__ctas { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-3) var(--s-5); margin-top: var(--s-3); }
  .about__photo { max-width: 400px; border-radius: var(--r-img); overflow: hidden; aspect-ratio: 3 / 4; background: var(--surface); }
  .about__photo :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: 50% 30%; }
  .about__now > li, .about__lang-list > li { padding-block: var(--s-4); color: var(--text-muted); }
  .about__now :global(strong) { color: var(--text); font-weight: 600; }
  .about__col .h2 { margin-bottom: var(--s-5); max-width: 20ch; }
  @media (min-width: 1024px) {
    .about__text { grid-column: 1 / span 7; }
    .about__photo { grid-column: 9 / -1; }
    .about__col { grid-column: 1 / span 6; }
    .about__langs { grid-column: 8 / -1; }
  }
</style>
