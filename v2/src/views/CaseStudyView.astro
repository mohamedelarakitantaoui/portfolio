---
// Case study template (v3): header (meta, title, outcome, real media) → overview sidebar (Role · Timeline · Team ·
// Stack · Status · Links) → TL;DR (3 bullets) → chapters 01–06 → next project.
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import ProjectMedia from '../components/ProjectMedia.astro';
import Diagram from '../components/Diagram.astro';
import Flow from '../components/mdx/Flow.astro';
import AneuApp from '../components/mdx/AneuApp.astro';
import AneuReport from '../components/mdx/AneuReport.astro';
import Chapter from '../components/mdx/Chapter.astro';
import PullQuote from '../components/mdx/PullQuote.astro';
import Stats from '../components/mdx/Stats.astro';
import Rows from '../components/mdx/Rows.astro';
import Note from '../components/mdx/Note.astro';
import Todo from '../components/mdx/Todo.astro';
import ModelCard from '../components/mdx/ModelCard.astro';
import HBars from '../components/mdx/HBars.astro';
import Figure from '../components/mdx/Figure.astro';
import { type Lang, lp, t } from '../i18n/ui';
import { person } from '../data/site';
import { rich, shows } from '../lib/rich';
interface Props { project: CollectionEntry<'projects'>; lang: Lang }
const { project, lang } = Astro.props;
const d = project.data;
const { Content } = await render(project);
const published = (p: CollectionEntry<'projects'>) => p.data.caseStudy && (import.meta.env.DEV || !p.data.draft);
const all = await getCollection('projects', (p) => p.data.lang === lang);
// Follow the `next` chain until it lands on a page that exists in this build.
let next = all.find((p) => p.data.key === d.next);
for (let i = 0; next && !published(next) && i < all.length; i++) next = all.find((p) => p.data.key === next!.data.next);
const fr = lang === 'fr';
const meta: [string, string][] = [
  [t(lang, 'meta.role'), d.role],
  [t(lang, 'meta.timeline'), d.timeline],
  [t(lang, 'meta.team'), d.team],
  [t(lang, 'meta.stack'), d.stack.filter((s) => shows(s)).join(', ')],
  [t(lang, 'meta.status'), d.status],
];
const newTab = fr ? 'nouvel onglet' : 'opens in a new tab';
const chapters = [...(project.body ?? '').matchAll(/<Chapter\s+n="([^"]+)"\s+label="([^"]+)"\s+title="([^"]+)"/g)]
  .filter(([, , , title]) => shows(title));
---
<Base lang={lang} title={`${d.title} · ${t(lang, 'cs.label')} · ${person.name}`} description={d.description} ogKey={`work-${d.key}`}>
  <article class="cs">
    <div class="cs__head-band"><div class="wrap cs__hero"><header class="cs__head">
      <nav class="crumbs meta" aria-label={fr ? 'Fil d’Ariane' : 'Breadcrumb'}>
        <a href={lp(lang, '/work')}>{t(lang, 'nav.work')}</a><span aria-hidden="true">/</span><span aria-current="page">{d.title}</span>
      </nav>
      <p class="label label--plain">{d.meta}</p>
      <h1 class="h1 cs__title">{d.title}</h1>
      <p class="lede cs__outcome" set:html={rich(d.outcome)} />
      {d.metric && <p class="cs__metric" set:html={rich(d.metric)} />}
    </header>

    {(d.loop || d.cover || d.bars) && (
      <div class="cs__cover">
        <ProjectMedia project={project} lang={lang} eager />
      </div>
    )}
    </div></div>

    {chapters.length > 0 && <nav class="cs__contents wrap" aria-label={fr ? 'Chapitres du projet' : 'Project chapters'}>
      {chapters.map(([, n, label]) => <a href={`#ch-${n}`}><span>{n}</span>{label}</a>)}
    </nav>}

    <div class="wrap grid-12 cs__grid">
      <aside class="cs__side" aria-label={fr ? 'Fiche projet' : 'Project overview'}>
        <div class="cs__sticky">
          <p class="label label--plain cs__side-label">{fr ? 'Fiche projet' : 'Overview'}</p>
          <dl class="cs__meta">
            {meta.filter(([, v]) => shows(v)).map(([k, v]) => (
              <div><dt class="meta">{k}</dt><dd set:html={rich(v)} /></div>
            ))}
            {(d.links.length > 0 || d.codeNote) && (
              <div>
                <dt class="meta">{t(lang, 'meta.links')}</dt>
                <dd>
                  {d.links.length > 0 && <ul class="cs__links">{d.links.map((l) => {
                    const ext = /^https?:/.test(l.href);
                    return <li><a href={l.href} target={ext ? '_blank' : undefined} rel={ext ? 'noopener' : undefined}>{l.label}{ext && <Fragment><span aria-hidden="true"> ↗</span><span class="sr-only"> ({newTab})</span></Fragment>}</a></li>;
                  })}</ul>}
                  {d.codeNote && <p class="cs__codenote">{d.codeNote} <a href={lp(lang, '/contact')}>{fr ? 'Me contacter' : 'Ask me'} →</a></p>}
                </dd>
              </div>
            )}
          </dl>
          {d.number ? (
            <div class="cs__big">
              <span class="cs__big-value">{d.number.value}</span>
              <span class="cs__big-caption" set:html={rich(d.number.caption)} />
            </div>
          ) : null}
          {d.progress && (
            <p class="cs__progress"><span class="cs__dot" aria-hidden="true"></span><span set:html={rich(d.progress)} /></p>
          )}
        </div>
      </aside>

      <div class="cs__body">
        {d.tldr && (
          <section class="tldr" aria-labelledby="tldr-h">
            <h2 class="tldr__h label label--plain" id="tldr-h">{t(lang, 'cs.tldr')}</h2>
            <ul class="tldr__list">
              {d.tldr.map((b) => <li set:html={rich(b)} />)}
            </ul>
          </section>
        )}
        <Content components={{ Chapter, PullQuote, Stats, Rows, Note, Todo, Diagram, Flow, AneuApp, AneuReport, ModelCard, HBars, Figure }} />
      </div>
    </div>

    {next && next.data.key !== d.key && (
      <a class="cs__next" href={lp(lang, `/work/${next.data.key}`)}>
        <span class="wrap cs__next-inner">
          <span class="label cs__next-label">{t(lang, 'cta.nextProject')}</span>
          <span class="cs__next-title">{next.data.title}</span>
        </span>
      </a>
    )}
  </article>
</Base>

<style>
  .cs__head-band { background: var(--bg-band); border-bottom: 1px solid var(--line); }
  .cs__hero { display: grid; gap: var(--s-7); padding-top: calc(var(--header-h) + var(--s-7)); padding-bottom: var(--s-7); }
  .cs__head, .cs__cover { min-width: 0; }
  .cs__title { font-size: var(--fs-feature); overflow-wrap: anywhere; }
  @media (min-width: 1024px) { .cs__hero { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: var(--s-7); align-items: center; min-height: 640px; } }
  .cs__contents { display: flex; flex-wrap: wrap; gap: var(--s-2) var(--s-5); padding-block: var(--s-5); border-bottom: 1px solid var(--line); }
  .cs__contents a { display: inline-flex; align-items: center; min-height: 44px; gap: var(--s-2); font-size: var(--fs-small); text-decoration: none; }
  .cs__contents a span { color: var(--accent); }
  .cs__contents a:hover { text-decoration: underline; text-decoration-color: var(--accent); }
  .crumbs { display: flex; gap: var(--s-2); color: var(--text-quiet); margin-bottom: var(--s-6); font-size: var(--fs-small); }
  .crumbs a { color: var(--text-muted); text-decoration: none; min-height: 44px; display: inline-flex; align-items: center; }
  .crumbs a:hover { color: var(--heading); }
  .crumbs span { display: inline-flex; align-items: center; }
  .cs__head .label { color: var(--text-quiet); }
  .cs__outcome { margin-top: var(--s-6); color: var(--text); max-width: 46ch; }
  .cs__metric { margin-top: var(--s-5); color: var(--heading); font-weight: var(--fw-regular); }
  .cs__grid { row-gap: var(--s-8); padding-block: var(--s-7); }
  @media (min-width: 1024px) {
    .cs__side { grid-column: 1 / span 4; }
    .cs__body { grid-column: 6 / -1; }
    .cs__side { position: sticky; top: calc(var(--header-h) + var(--s-5)); }
  }
  .cs__side { align-self: start; }
  .cs__side-label { color: var(--text-quiet); margin-bottom: var(--s-3); }
  .cs__meta > div { display: grid; grid-template-columns: 6.5rem minmax(0, 1fr); gap: var(--s-3); padding-block: var(--s-3); border-top: 1px solid var(--line); font-size: var(--fs-small); }
  .cs__meta > div:last-child { border-bottom: 1px solid var(--line); }
  .cs__meta dt { color: var(--text-quiet); }
  .cs__meta dd { color: var(--text); overflow-wrap: anywhere; }
  .cs__links { list-style: none; display: grid; gap: var(--s-1); }
  .cs__links a { text-decoration-color: var(--accent); display: inline-block; padding-block: 10px; margin-block: -10px; }
  .cs__codenote { color: var(--text-muted); }
  .cs__codenote a { color: var(--text); text-decoration-color: var(--accent); white-space: nowrap; }
  .cs__big { display: grid; gap: var(--s-2); margin-top: var(--s-6); }
  .cs__big-value { font-size: var(--fs-h2); font-weight: var(--fw-thin); letter-spacing: var(--track-h); line-height: 1; color: var(--heading); }
  .cs__big-caption { color: var(--text-muted); font-size: var(--fs-small); }
  .cs__progress { display: flex; gap: var(--s-3); align-items: baseline; margin-top: var(--s-4); padding-top: var(--s-4); border-top: 1px solid var(--line); }
  .cs__dot { flex: none; width: 7px; height: 7px; border-radius: 50%; background: var(--accent); }
  .cs__body { min-width: 0; container-type: inline-size; }
  .tldr { border-block: 1px solid var(--line-strong); padding-block: var(--s-6); margin-bottom: var(--s-6); }
  .tldr__h { color: var(--accent); margin-bottom: var(--s-4); }
  .tldr__list { list-style: none; display: grid; gap: var(--s-4); }
  .tldr__list li { position: relative; padding-inline-start: 1.4em; color: var(--text-muted); max-width: var(--measure); font-size: var(--fs-lede); line-height: 1.6; }
  .tldr__list li::before { content: ''; position: absolute; inset-inline-start: 0; top: 0.85em; width: 0.6em; height: 1px; background: var(--text-quiet); }
  .tldr__list :global(strong) { color: var(--heading); font-weight: var(--fw-medium); }
  .cs__next { display: block; text-decoration: none; background: var(--bg-band); border-top: 1px solid var(--line); padding-block: var(--s-9); overflow-x: clip; }
  .cs__next-inner { display: grid; gap: var(--s-2); }
  .cs__next-label { margin-bottom: 0; }
  .cs__next-title {
    font-size: var(--fs-display); font-weight: var(--fw-thin); letter-spacing: var(--track-display); line-height: 0.94; color: var(--heading);
    text-wrap: balance; transition: color var(--dur-1) var(--ease-out);
  }
  .cs__next:hover .cs__next-title { color: var(--accent); }
</style>
