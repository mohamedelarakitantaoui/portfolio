---
// Case study (v5): poster opening (meta, the title in Jost 200 + a Cormorant subtitle on its own line, no comma;
// then the outcome, with the key metric large like the hero stats on the right, both top-aligned) → the project media big and framed → HUD row on a hairline (Role · Timeline · Team ·
// Stack · Links) → TL;DR in three hairline columns → chapters as numbered hairline sections → previous / next.
import { render, type CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import ProjectPager from '../components/ProjectPager.astro';
import ProjectMedia from '../components/ProjectMedia.astro';
import Diagram from '../components/Diagram.astro';
import Flow from '../components/mdx/Flow.astro';
import AneuApp from '../components/mdx/AneuApp.astro';
import AneuReport from '../components/mdx/AneuReport.astro';
import Chapter from '../components/mdx/Chapter.astro';
import PullQuote from '../components/mdx/PullQuote.astro';
import Stats from '../components/mdx/Stats.astro';
import Rows from '../components/mdx/Rows.astro';
import Note from '../components/mdx/Note.astro';
import Todo from '../components/mdx/Todo.astro';
import ModelCard from '../components/mdx/ModelCard.astro';
import HBars from '../components/mdx/HBars.astro';
import Figure from '../components/mdx/Figure.astro';
import HackathonCertificates from '../components/mdx/HackathonCertificates.astro';
import { type Lang, lp, t } from '../i18n/ui';
import { person } from '../data/site';
import { rich, shows } from '../lib/rich';
interface Props { project: CollectionEntry<'projects'>; lang: Lang }
const { project, lang } = Astro.props;
const d = project.data;
const { Content } = await render(project);
const fr = lang === 'fr';
const hud: [string, string][] = [
  [t(lang, 'meta.role'), d.role],
  [t(lang, 'meta.timeline'), d.timeline],
  [t(lang, 'meta.team'), d.team],
  [t(lang, 'meta.stack'), d.stack.filter((s) => shows(s)).join(' · ')],
];
const newTab = fr ? 'nouvel onglet' : 'opens in a new tab';
const chapters = [...(project.body ?? '').matchAll(/<Chapter\s+n="([^"]+)"\s+label="([^"]+)"\s+title="([^"]+)"/g)]
  .filter(([, , , title]) => shows(title));
// TL;DR bullets open with "**Problem:**", "**Built:**", "**Result:**": the bold lead becomes the column label.
const tldr = (d.tldr ?? []).map((b) => {
  const m = /^\*\*(.+?):?\*\*:?\s*(.*)$/s.exec(b);
  // The text loses its lead, so it starts with a capital.
  return m ? { label: m[1].replace(/\s*:$/, '').trim(), text: m[2].charAt(0).toLocaleUpperCase(lang) + m[2].slice(1) } : { label: '', text: b };
});
---
<Base lang={lang} title={`${d.title} · ${t(lang, 'cs.label')} · ${person.name}`} description={d.description} ogKey={`work-${d.key}`}>
  <article class="cs">
    <header class="cs__poster">
      <div class="wrap">
        <nav class="crumbs meta" aria-label={fr ? 'Fil d’Ariane' : 'Breadcrumb'}>
          <a href={lp(lang, '/work')}>{t(lang, 'nav.work')}</a><span aria-hidden="true">/</span><span aria-current="page">{d.title}</span>
        </nav>
        <p class="label">{d.meta}</p>
        <h1 class:list={['cs__title', { 'cs__title--long': d.title.length > 20 }]}>
          {d.subtitle ? <Fragment>{d.title}<span class="sr-only">: </span><span class="serif serif--line cs__clause">{d.subtitle}</span></Fragment> : d.title}
        </h1>
        <div class="cs__intro">
          <p class="lede cs__outcome" set:html={rich(d.outcome)} />
          <div class="cs__key">
            {d.number && (
              <p class="cs__stat">
                <span class="cs__stat-value">{d.number.value}</span>
                <span class="cs__stat-caption" set:html={rich(d.number.caption)} />
              </p>
            )}
            {d.progress
              ? <p class="cs__status"><span class="cs__dot" aria-hidden="true"></span><span set:html={rich(d.progress)} /></p>
              : shows(d.status) && <p class="cs__status"><span class="cs__dot" aria-hidden="true"></span><span set:html={rich(d.status)} /></p>}
          </div>
        </div>
      </div>
    </header>

    {(d.loop || d.cover || d.bars) && (
      <div class="wrap cs__media">
        <ProjectMedia project={project} lang={lang} eager />
      </div>
    )}

    <div class="wrap">
      <dl class="cs__hud">
        {hud.filter(([, v]) => shows(v)).map(([k, v]) => (
          <div><dt class="meta">{k}</dt><dd set:html={rich(v)} /></div>
        ))}
        {(d.links.length > 0 || d.codeNote) && (
          <div>
            <dt class="meta">{t(lang, 'meta.links')}</dt>
            <dd>
              {d.links.length > 0 && <ul class="cs__links">{d.links.map((l) => {
                const ext = /^https?:/.test(l.href);
                return <li><a href={l.href} target={ext ? '_blank' : undefined} rel={ext ? 'noopener' : undefined}>{l.label}{ext && <Fragment><span aria-hidden="true"> ↗</span><span class="sr-only"> ({newTab})</span></Fragment>}</a></li>;
              })}</ul>}
              {d.codeNote && <p class="cs__codenote">{d.codeNote} <a href={lp(lang, '/contact')}>{fr ? 'Me contacter' : 'Ask me'} →</a></p>}
            </dd>
          </div>
        )}
      </dl>

      {tldr.length > 0 && (
        <section class="tldr" aria-labelledby="tldr-h">
          <h2 class="label label--plain tldr__h" id="tldr-h">{t(lang, 'cs.tldr')}</h2>
          <ol class="tldr__cols">
            {tldr.map((b, i) => (
              <li>
                <p class="meta tldr__label"><span class="tldr__n">{String(i + 1).padStart(2, '0')}</span>{b.label}</p>
                <p class="tldr__text" set:html={rich(b.text)} />
              </li>
            ))}
          </ol>
        </section>
      )}

      {chapters.length > 0 && <nav class="cs__contents" aria-label={fr ? 'Chapitres du projet' : 'Project chapters'}>
        {chapters.map(([, n, label]) => <a href={`#ch-${n}`}><span>{n}</span>{label}</a>)}
      </nav>}

      <div class="cs__body">
        <Content components={{ Chapter, PullQuote, Stats, Rows, Note, Todo, Diagram, Flow, AneuApp, AneuReport, ModelCard, HBars, Figure, HackathonCertificates }} />
      </div>
    </div>

    <ProjectPager lang={lang} current={d.key} />
  </article>
</Base>

<style>
  /* Poster */
  .cs__poster { padding-top: calc(var(--header-h) + var(--s-7)); padding-bottom: var(--s-7); }
  @media (min-width: 1024px) { .cs__poster { padding-top: calc(var(--header-h) + var(--s-8)); } }
  .crumbs { display: flex; gap: var(--s-2); color: var(--text-quiet); margin-bottom: var(--s-5); font-size: var(--fs-small); }
  .crumbs a { color: var(--text-muted); text-decoration: none; min-height: 44px; display: inline-flex; align-items: center; }
  .crumbs a:hover { color: var(--heading); }
  .crumbs span { display: inline-flex; align-items: center; }
  .cs__title {
    font-size: var(--fs-poster); font-weight: var(--fw-thin); letter-spacing: var(--track-display); line-height: 0.92;
    color: var(--heading); text-wrap: balance; overflow-wrap: anywhere;
  }
  /* Long titles ("Knee MRI Abnormality Detection") stay on one line at 1920 so the metric and media fit the first screen. */
  .cs__title--long { font-size: var(--fs-poster-long); }
  .cs__clause { font-size: var(--fs-poster-clause); line-height: 1.15; margin-top: 0.3em; color: var(--text); text-wrap: balance; }
  .cs__intro { display: grid; gap: var(--s-6); margin-top: var(--s-6); }
  .cs__outcome { color: var(--text); max-width: 46ch; }
  .cs__key { display: grid; gap: var(--s-4); align-content: start; }
  .cs__stat { display: grid; gap: var(--s-2); }
  .cs__stat-value { font-size: var(--fs-h2); font-weight: var(--fw-thin); letter-spacing: var(--track-h); line-height: 1; color: var(--heading); font-variant-numeric: tabular-nums; }
  .cs__stat-caption { font-size: var(--fs-label); letter-spacing: var(--track-label); text-transform: uppercase; color: var(--text-muted); line-height: 1.6; max-width: 34ch; }
  .cs__status { display: flex; gap: var(--s-3); align-items: baseline; padding-top: var(--s-4); border-top: 1px solid var(--line); color: var(--text-muted); font-size: var(--fs-small); max-width: 46ch; }
  .cs__dot { flex: none; width: 6px; height: 6px; background: var(--accent); transform: translateY(-2px); }
  @media (min-width: 1024px) {
    .cs__intro { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); column-gap: var(--grid-gap); align-items: start; }
    .cs__key { justify-self: end; width: min(100%, 30rem); }
  }

  /* Media: big, framed (ProjectMedia draws the frame and the dim) */
  .cs__media { padding-bottom: var(--s-7); }

  /* HUD row */
  .cs__hud { display: grid; gap: 0 var(--s-6); border-block: 1px solid var(--line-strong); }
  .cs__hud > div { display: grid; gap: var(--s-2); align-content: start; padding-block: var(--s-5); border-top: 1px solid var(--line); min-width: 0; font-size: var(--fs-small); }
  .cs__hud > div:first-child { border-top: 0; }
  .cs__hud dt { color: var(--text-quiet); }
  .cs__hud dd { color: var(--text); overflow-wrap: anywhere; }
  @media (min-width: 768px) {
    .cs__hud { grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr)); }
    .cs__hud > div { border-top: 0; }
  }
  .cs__links { list-style: none; display: grid; gap: var(--s-1); }
  .cs__links a { color: var(--text); text-decoration-color: var(--accent); display: inline-block; padding-block: 10px; margin-block: -10px; }
  .cs__codenote { color: var(--text-muted); }
  .cs__codenote a { color: var(--text); text-decoration-color: var(--accent); white-space: nowrap; }

  /* TL;DR: three hairline columns */
  .tldr { padding-block: var(--s-8) var(--s-7); }
  .tldr__h { color: var(--accent); margin-bottom: var(--s-5); }
  .tldr__cols { list-style: none; display: grid; gap: 0 var(--s-6); }
  .tldr__cols > li { display: grid; gap: var(--s-3); align-content: start; padding-block: var(--s-5); border-top: 1px solid var(--line); min-width: 0; }
  @media (min-width: 900px) { .tldr__cols { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .tldr__label { display: flex; gap: var(--s-3); color: var(--text-muted); }
  .tldr__n { color: var(--accent); }
  .tldr__text { color: var(--text); }
  .tldr__text :global(strong) { color: var(--heading); font-weight: var(--fw-medium); }

  /* Chapter index */
  .cs__contents { display: flex; flex-wrap: wrap; gap: var(--s-2) var(--s-5); padding-block: var(--s-3); border-block: 1px solid var(--line); }
  .cs__contents a { display: inline-flex; align-items: center; min-height: 44px; gap: var(--s-2); font-size: var(--fs-small); color: var(--text-muted); text-decoration: none; }
  .cs__contents a span { color: var(--accent); font-size: var(--fs-label); letter-spacing: var(--track-label); }
  .cs__contents a:hover { color: var(--heading); }

  .cs__body { min-width: 0; padding-bottom: var(--section-y); }
  .cs__body > :global(.note) { margin-top: var(--s-7); }
</style>
