---
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import CopyEmail from '../components/CopyEmail.astro';
import Rich from '../components/Rich.astro';
import { person, status } from '../data/site';
import { type Lang, lp } from '../i18n/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;
const fr = lang === 'fr';
// Messages go through FormSubmit (formsubmit.co, free, no account), which emails them to person.email. With JS,
// main.ts posts to the AJAX endpoint and shows the thank-you in place; without JS the browser posts to `action` and
// FormSubmit sends the visitor back to /contact/sent. The first message ever sent triggers a one-time activation
// email to that address; nothing is delivered until it is confirmed.
const formAction = `https://formsubmit.co/${person.email}`;
const formAjax = `https://formsubmit.co/ajax/${person.email}`;
const sentUrl = new URL(lp(lang, '/contact/sent'), Astro.site).href;
const F = fr
  ? { name: 'Votre nom', email: 'Votre e-mail', msg: 'Message', send: 'Envoyer', errName: 'Indiquez votre nom.', errEmail: 'Indiquez une adresse e-mail valide.', errMsg: 'Écrivez quelques mots.', ok: 'Merci, votre message est bien parti.', fallback: 'Le message n’a pas pu partir : votre application e-mail va s’ouvrir avec le message prêt. Sinon, écrivez à elaraki48@gmail.com.', note: 'Votre nom, votre e-mail et votre message servent uniquement à vous répondre.' }
  : { name: 'Your name', email: 'Your email', msg: 'Message', send: 'Send', errName: 'Please add your name.', errEmail: 'Please add a valid email address.', errMsg: 'Please write a few words.', ok: 'Thanks, your message is on its way.', fallback: 'The message couldn’t be sent, so your email app will open with it ready. Otherwise, write to elaraki48@gmail.com.', note: 'Your name, email and message are only used to reply to you.' };
---
<Base
  lang={lang}
  title={`Contact · ${person.name}`}
  description={fr
    ? 'Écrivez à Mamoun El Araki : elaraki48@gmail.com. Basé au Maroc (GMT+1), ouvert au travail à distance et à la relocalisation.'
    : 'Write to Mamoun El Araki: elaraki48@gmail.com. Based in Morocco (GMT+1), open to remote and relocation, for junior roles and freelance projects.'}
  ogKey="contact"
>
  <PageIntro label="Contact" title={fr ? 'Un poste ou un projet ?' : 'A role or a project?'} lede={fr ? 'Écrivez-moi directement ou laissez quelques détails ci-dessous.' : 'Email me directly, or leave a few details below.'}>
    <p class="contact__email-wrap"><a class="contact__email" href={`mailto:${person.email}`}>{person.email}</a></p>
    <div class="contact__actions">
      <CopyEmail lang={lang} class="btn--primary" />
      <a class="link" href={person.linkedin} target="_blank" rel="noopener">LinkedIn<span class="sr-only"> ({fr ? 'nouvel onglet' : 'opens in a new tab'})</span></a>
      <a class="link" href={person.github} target="_blank" rel="noopener">GitHub<span class="sr-only"> ({fr ? 'nouvel onglet' : 'opens in a new tab'})</span></a>
      <a class="link link--plain" href={lp(lang, '/cv')}>CV <span aria-hidden="true">→</span></a>
    </div>
  </PageIntro>

  <section class="section band" aria-label={fr ? 'Formulaire et disponibilités' : 'Form and availability'}>
    <div class="wrap contact__grid">
      <div class="contact__info">
        <dl class="contact__facts">
          <div><dt class="meta">{fr ? 'Lieu' : 'Location'}</dt><dd>{fr ? 'Basé au Maroc (GMT+1), ouvert au travail à distance et à la relocalisation' : 'Based in Morocco (GMT+1), open to remote and relocation'}</dd></div>
          <div><dt class="meta">{fr ? 'Recruteurs' : 'Employers'}</dt><dd><Rich text={status.employers[lang]} /></dd></div>
          <div><dt class="meta">{fr ? 'Clients' : 'Clients'}</dt><dd>{status.clients[lang]} <a href={lp(lang, '/services')}>{fr ? 'Voir les services' : 'See services'} →</a></dd></div>
        </dl>
      </div>

      <div class="contact__formwrap">
        <h2 class="h3 contact__formtitle">{fr ? 'Votre message' : 'Your message'}</h2>
        <form class="cform" name="contact" method="POST" action={formAction} data-endpoint={formAjax} data-contact-form>
          <input type="hidden" name="_subject" value={fr ? 'Portfolio : nouveau message' : 'Portfolio: new message'} />
          <input type="hidden" name="_template" value="table" />
          <input type="hidden" name="_next" value={sentUrl} />
          <p class="sr-only"><label>Company <input type="text" name="_honey" tabindex="-1" autocomplete="off" /></label></p>
          <div class="field">
            <label for="cf-topic">{fr ? 'Sujet' : 'About'}</label>
            <select id="cf-topic" name="topic">
              <option value="general">{fr ? 'Une question ou une discussion' : 'A question or conversation'}</option>
              <option value="role">{fr ? 'Un poste' : 'A role'}</option>
              <option value="automation">{fr ? 'Automatisation et données' : 'Automation and data collection'}</option>
              <option value="web-app">{fr ? 'Une application web' : 'A web application'}</option>
            </select>
          </div>
          <div class="field">
            <label for="cf-name">{F.name}</label>
            <input id="cf-name" name="name" type="text" autocomplete="name" required aria-describedby="cf-name-err" data-error={F.errName} />
            <p class="field__err" id="cf-name-err"></p>
          </div>
          <div class="field">
            <label for="cf-email">{F.email}</label>
            <input id="cf-email" name="email" type="email" autocomplete="email" required aria-describedby="cf-email-err" data-error={F.errEmail} />
            <p class="field__err" id="cf-email-err"></p>
          </div>
          <div class="field">
            <label for="cf-msg">{F.msg}</label>
            <textarea id="cf-msg" name="message" rows="6" required minlength="10" aria-describedby="cf-msg-err cf-msg-help" data-error={F.errMsg}></textarea>
            <p class="cform__note" id="cf-msg-help">{fr ? 'Pour un poste : l’équipe et la mission. Pour un projet : le besoin, les données disponibles et vos délais.' : 'For a role: the team and position. For a project: the problem, available data and your timeline.'}</p>
            <p class="field__err" id="cf-msg-err"></p>
          </div>
          <button class="btn btn--primary" type="submit">{F.send} <span class="btn__arrow" aria-hidden="true">→</span></button>
          <p class="cform__note">{F.note}</p>
        </form>
        <p class="cform__msg" data-form-success tabindex="-1" role="status" hidden>{F.ok}</p>
        <p class="cform__msg" data-form-fallback tabindex="-1" role="status" hidden>{F.fallback}</p>
      </div>
    </div>
  </section>
</Base>

<style>
  /* The email as a headline, like the footer: Jost 200, a hairline underline that turns champagne on hover. */
  .contact__email-wrap { margin-top: var(--s-6); max-width: none; }
  .contact__email {
    display: inline-block; font-size: var(--fs-email); font-weight: var(--fw-thin); line-height: 1.15; color: var(--heading);
    text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.18em; text-decoration-color: var(--line-strong);
    overflow-wrap: anywhere; transition: text-decoration-color var(--dur-2) var(--ease-out);
  }
  .contact__email:hover, .contact__email:focus-visible { text-decoration-color: var(--accent); }
  .contact__actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-3) var(--s-6); margin-top: var(--s-5); }
  .link--plain::after { content: none; }

  .contact__grid { display: grid; gap: var(--s-8); }
  @media (min-width: 1024px) { .contact__grid { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); align-items: start; } }
  .contact__facts > div { display: grid; gap: var(--s-2); padding-block: var(--s-5); border-top: 1px solid var(--line); }
  .contact__facts > div:last-child { border-bottom: 1px solid var(--line); }
  .contact__facts dt { color: var(--text-quiet); }
  .contact__facts dd { color: var(--text-muted); }
  .contact__facts a { color: var(--text); text-decoration-color: var(--accent); }

  /* The form: one sharp --surface panel with a hairline, labels as small uppercase meta, inputs on the page colour. */
  .contact__formwrap { background: var(--surface); padding: var(--s-6); border: 1px solid var(--line); border-radius: var(--r-img); }
  @media (min-width: 1024px) { .contact__formwrap { padding: var(--s-7); } }
  .contact__formtitle { margin-bottom: var(--s-6); }
  .cform { display: grid; gap: var(--s-5); }
  .field { display: grid; gap: var(--s-2); }
  .field label {
    font-size: var(--fs-label); font-weight: var(--fw-regular); letter-spacing: var(--track-label);
    text-transform: uppercase; color: var(--text-muted);
  }
  .field input, .field textarea, .field select {
    width: 100%; min-height: 48px; padding: var(--s-3) var(--s-4); border-radius: var(--r-btn);
    border: 1px solid var(--line-input); background: var(--bg); color: var(--text); font: inherit;
    transition: border-color var(--dur-btn) var(--ease-out);
  }
  .field input:hover, .field textarea:hover, .field select:hover { border-color: var(--text-quiet); }
  .field textarea { resize: vertical; min-height: 160px; }
  .field input:focus-visible, .field textarea:focus-visible, .field select:focus-visible { outline: 1px solid var(--accent); outline-offset: 0; border-color: var(--accent); }
  .field [aria-invalid='true'] { border-color: var(--accent); }
  .field__err { color: var(--accent-hover); font-size: var(--fs-small); min-height: 1em; }
  .cform .btn { justify-self: start; }
  .cform__note { color: var(--text-muted); font-size: var(--fs-small); }
  .cform__msg { padding: var(--s-5); border: 1px solid var(--accent-line); background: var(--surface); }
</style>
