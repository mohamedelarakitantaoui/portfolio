---
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import CopyEmail from '../components/CopyEmail.astro';
import Rich from '../components/Rich.astro';
import Todo from '../components/mdx/Todo.astro';
import { person, status } from '../data/site';
import { type Lang, lp } from '../i18n/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;
const fr = lang === 'fr';
const F = fr
  ? { name: 'Votre nom', email: 'Votre e-mail', msg: 'Message', send: 'Envoyer', errName: 'Indiquez votre nom.', errEmail: 'Indiquez une adresse e-mail valide.', errMsg: 'Écrivez quelques mots.', ok: 'Merci, votre message est bien parti.', fallback: 'Ce site n’a pas encore de service de formulaire : votre application e-mail va s’ouvrir avec le message prêt. Sinon, écrivez à elaraki48@gmail.com.', note: 'Votre nom, votre e-mail et votre message servent uniquement à vous répondre.' }
  : { name: 'Your name', email: 'Your email', msg: 'Message', send: 'Send', errName: 'Please add your name.', errEmail: 'Please add a valid email address.', errMsg: 'Please write a few words.', ok: 'Thanks, your message is on its way.', fallback: 'This site has no form service yet, so your email app will open with the message ready. Otherwise, write to elaraki48@gmail.com.', note: 'Your name, email and message are only used to reply to you.' };
---
<Base
  lang={lang}
  title={`Contact · ${person.name}`}
  description={fr
    ? 'Écrivez à Mamoun El Araki : elaraki48@gmail.com. Basé au Maroc (GMT+1), ouvert au travail à distance et à la relocalisation.'
    : 'Write to Mamoun El Araki: elaraki48@gmail.com. Based in Morocco (GMT+1), open to remote and relocation, for junior roles and freelance projects.'}
  ogKey="contact"
>
  <PageIntro label="Contact" title="Contact" word="SALAM">
    <a class="contact__email" href={`mailto:${person.email}`}>{person.email}</a>
    <div class="contact__actions"><CopyEmail lang={lang} /><a class="btn" href={person.linkedin} target="_blank" rel="noopener">LinkedIn<span class="sr-only"> ({fr ? 'nouvel onglet' : 'opens in a new tab'})</span></a><a class="btn" href={person.github} target="_blank" rel="noopener">GitHub<span class="sr-only"> ({fr ? 'nouvel onglet' : 'opens in a new tab'})</span></a><a class="btn" href={lp(lang, '/cv')}>CV</a></div>
  </PageIntro>

  <section class="section band" aria-label={fr ? 'Formulaire et disponibilités' : 'Form and availability'}>
    <div class="wrap contact__grid">
      <div class="contact__info">
        <dl class="contact__facts">
          <div><dt class="mono">{fr ? 'Lieu' : 'Location'}</dt><dd>{fr ? 'Basé au Maroc (GMT+1), ouvert au travail à distance et à la relocalisation' : 'Based in Morocco (GMT+1), open to remote and relocation'}</dd></div>
          <div><dt class="mono">{fr ? 'Recruteurs' : 'Employers'}</dt><dd><Rich text={status.employers[lang]} /></dd></div>
          <div><dt class="mono">{fr ? 'Clients' : 'Clients'}</dt><dd>{status.clients[lang]} <a href={lp(lang, '/services')}>{fr ? 'Voir les services' : 'See services'} →</a></dd></div>
        </dl>
      </div>

      <div class="contact__formwrap">
        <form class="cform" name="contact" method="POST" action={lp(lang, '/contact/sent')} data-netlify="true" netlify-honeypot="company" data-contact-form novalidate>
          <input type="hidden" name="form-name" value="contact" />
          <p class="sr-only"><label>Company <input name="company" tabindex="-1" autocomplete="off" /></label></p>
          <div class="field">
            <label for="cf-name">{F.name}</label>
            <input id="cf-name" name="name" type="text" autocomplete="name" required aria-describedby="cf-name-err" data-error={F.errName} />
            <p class="field__err" id="cf-name-err"></p>
          </div>
          <div class="field">
            <label for="cf-email">{F.email}</label>
            <input id="cf-email" name="email" type="email" autocomplete="email" required aria-describedby="cf-email-err" data-error={F.errEmail} />
            <p class="field__err" id="cf-email-err"></p>
          </div>
          <div class="field">
            <label for="cf-msg">{F.msg}</label>
            <textarea id="cf-msg" name="message" rows="6" required minlength="10" aria-describedby="cf-msg-err" data-error={F.errMsg}></textarea>
            <p class="field__err" id="cf-msg-err"></p>
          </div>
          <button class="btn btn--primary" type="submit">{F.send}<span class="arrow" aria-hidden="true">→</span></button>
          <p class="cform__note">{F.note} <Todo>{fr ? 'choisir le service de formulaire (Netlify Forms ou Formspree)' : 'pick the form service (Netlify Forms or Formspree)'}</Todo></p>
        </form>
        <p class="cform__msg" data-form-success tabindex="-1" role="status" hidden>{F.ok}</p>
        <p class="cform__msg" data-form-fallback tabindex="-1" role="status" hidden>{F.fallback}</p>
      </div>
    </div>
  </section>
</Base>

<style>
  .contact__email {
    display: inline-block; margin-top: var(--s-6); font-family: var(--font-display); font-weight: 600;
    font-size: clamp(1.75rem, 6vw, 4.5rem); letter-spacing: var(--track-display); line-height: 1; overflow-wrap: anywhere;
    text-decoration-color: var(--accent-wall); text-decoration-thickness: 2px; text-underline-offset: 0.15em;
  }
  .contact__actions { display: flex; flex-wrap: wrap; gap: var(--s-3); margin-top: var(--s-6); }
  .contact__grid { display: grid; gap: var(--s-8); }
  @media (min-width: 1024px) { .contact__grid { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); } }
  .contact__facts > div { display: grid; gap: var(--s-1); padding-block: var(--s-4); border-top: 1px solid var(--line); }
  .contact__facts dt { color: var(--text-quiet); }
  .contact__facts dd { color: var(--text-muted); }
  .contact__facts a { color: var(--text); }
  .cform { display: grid; gap: var(--s-5); }
  .field { display: grid; gap: var(--s-2); }
  .field label { font-weight: 500; }
  .field input, .field textarea, .field select {
    width: 100%; min-height: 48px; padding: var(--s-3) var(--s-4); border-radius: 12px;
    border: 1px solid var(--line-input); background: var(--bg); color: var(--text); font: inherit;
  }
  .field textarea { resize: vertical; min-height: 140px; }
  .field input:focus-visible, .field textarea:focus-visible, .field select:focus-visible { outline: 2px solid var(--accent-wall); outline-offset: 1px; }
  .field [aria-invalid='true'] { border-color: var(--accent); }
  .field__err { color: var(--accent-hover); font-size: var(--fs-small); min-height: 1em; }
  .cform .btn { justify-self: start; }
  .cform__note { color: var(--text-muted); font-size: var(--fs-small); }
  .cform__msg { padding: var(--s-5); border: 1px solid var(--accent-wall); border-radius: var(--r-lg); }
</style>
