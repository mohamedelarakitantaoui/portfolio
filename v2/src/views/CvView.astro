---
// Web CV in Experience-row format + PDF downloads. A PDF button appears only once its file exists in public/cv/.
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import Todo from '../components/mdx/Todo.astro';
import { education, experience, moreProjects, person, skills, spoken, status } from '../data/site';
import { cvFor } from '../lib/cv';
import { type Lang, lp } from '../i18n/ui';
import { rich, shows } from '../lib/rich';
interface Props { lang: Lang }
const { lang } = Astro.props;
const fr = lang === 'fr';
const featured = (await getCollection('projects', (p) => p.data.lang === lang && p.data.tier === 'featured')).sort((a, b) => a.data.order - b.data.order);
const pdfs = cvFor(lang);
const ready = pdfs.filter((d) => d.href);
const newTab = fr ? 'nouvel onglet' : 'opens in a new tab';
---
<Base
  lang={lang}
  title={`CV · ${person.name}`}
  description={fr
    ? 'CV de Mamoun El Araki, ingénieur IA et logiciel : Intelcia, ITS Elaraki, Université Al Akhawayn et Boğaziçi, projets, compétences.'
    : 'CV of Mamoun El Araki, AI and software engineer: Intelcia, ITS Elaraki, Al Akhawayn and Boğaziçi universities, projects and skills.'}
  ogKey="cv"
>
  <PageIntro label="Curriculum vitae" title={fr ? 'Parcours & compétences.' : 'Experience & skills.'} lede={fr ? 'Consultez mon parcours ci-dessous ou téléchargez le CV adapté au poste.' : 'Read my background below, or download the CV that fits the role.'}>
    {ready.length > 0 && (
      <ul class="downloads rows" aria-label={fr ? 'Versions PDF' : 'PDF versions'}>
        {ready.map((d) => (
          <li class="dl">
            <span class="dl__label">{d.label[lang]}</span>
            <a class="btn btn--sm" href={d.href} download aria-label={`${d.label[lang]} — PDF · ${d.size}`}>PDF · {d.size}</a>
          </li>
        ))}
      </ul>
    )}
    {pdfs.filter((d) => !d.href).map((d) => <p class="dl__todo"><Todo>{d.todo[lang]}</Todo></p>)}
    <p class="cv__updated">{fr ? 'Mis à jour en octobre 2026' : 'Updated October 2026'}</p>
  </PageIntro>

  <section class="section band" aria-label={fr ? 'CV en ligne' : 'Web CV'}>
    <div class="wrap cv-layout">
      <nav class="cv-index" aria-label={fr ? 'Sections du CV' : 'CV sections'}>
        <p class="label label--plain">{fr ? 'Dans cette page' : 'On this page'}</p>
        <a href="#cv-exp">01 <span>{fr ? 'Expérience' : 'Experience'}</span></a>
        <a href="#cv-proj">02 <span>{fr ? 'Projets' : 'Projects'}</span></a>
        <a href="#cv-edu">03 <span>{fr ? 'Formation' : 'Education'}</span></a>
        <a href="#cv-skills">04 <span>{fr ? 'Compétences' : 'Skills'}</span></a>
      </nav>
      <article class="paper">
        <header class="paper__head">
          <h2 class="paper__name">{person.name}</h2>
          <p class="paper__role">{person.role[lang]}</p>
          <p class="paper__contact">
            <a href={`mailto:${person.email}`}>{person.email}</a>
            <span aria-hidden="true"> · </span>
            <a href={person.linkedin} target="_blank" rel="noopener">LinkedIn<span class="sr-only"> ({newTab})</span></a>
            <span aria-hidden="true"> · </span>
            <a href={person.github} target="_blank" rel="noopener">GitHub<span class="sr-only"> ({newTab})</span></a>
          </p>
          <p class="paper__status" set:html={rich(status.employers[lang])} />
        </header>

        <section class="paper__sec" aria-labelledby="cv-exp">
          <h3 class="paper__h" id="cv-exp">{fr ? 'Expérience' : 'Experience'}</h3>
          <ol class="paper__rows">
            {experience.map((e) => (
              <li class="paper__item">
                <p class="paper__when"><span class="paper__year">{e.year}</span>{shows(e.span[lang]) && <span set:html={rich(e.span[lang])} />}</p>
                <div>
                  <h4 set:html={rich(`${e.role[lang]} · ${e.org}, ${e.location}`)} />
                  {shows(e.result[lang]) && <p set:html={rich(e.result[lang])} />}
                  {e.tags.length > 0 && <ul class="tags paper__tags">{e.tags.map((tg) => <li class="tag">{tg}</li>)}</ul>}
                </div>
              </li>
            ))}
          </ol>
        </section>

        <section class="paper__sec" aria-labelledby="cv-proj">
          <h3 class="paper__h" id="cv-proj">{fr ? 'Projets' : 'Projects'}</h3>
          <ol class="paper__rows">
            {featured.map((p) => (
              <li class="paper__item">
                <p class="paper__when"><span class="paper__year">{p.data.year}</span>{p.data.number && <span>{p.data.number.value}</span>}</p>
                <div>
                  <h4><a href={lp(lang, `/work/${p.data.key}`)}>{p.data.title}</a></h4>
                  <p set:html={rich(p.data.outcome)} />
                </div>
              </li>
            ))}
            {moreProjects.map((p) => (
              <li class="paper__item">
                <p class="paper__when">{shows(p.year) && <span class="paper__year" set:html={rich(p.year)} />}</p>
                <div>
                  <h4><a href={lp(lang, `/work/${p.key}`)}>{p.title}</a></h4>
                  <p set:html={rich(p.line[lang])} />
                </div>
              </li>
            ))}
          </ol>
        </section>

        <section class="paper__sec" aria-labelledby="cv-edu">
          <h3 class="paper__h" id="cv-edu">{fr ? 'Formation' : 'Education'}</h3>
          <ol class="paper__rows">
            {education.map((e) => (
              <li class="paper__item">
                <p class="paper__when">{e.dates[lang]}</p>
                <div><h4>{e.school}</h4><p set:html={rich(e.degree[lang])} /></div>
              </li>
            ))}
          </ol>
        </section>

        <section class="paper__sec" aria-labelledby="cv-skills">
          <h3 class="paper__h" id="cv-skills">{fr ? 'Compétences' : 'Skills'}</h3>
          {skills.map((s) => (
            <div class="paper__item"><p class="paper__when">{s.group[lang]}</p><p>{s.items}</p></div>
          ))}
          <div class="paper__item"><p class="paper__when">{fr ? 'Langues' : 'Languages'}</p><p>{spoken[lang].join(', ')}</p></div>
        </section>
      </article>
    </div>
  </section>
</Base>

<style>
  .cv-layout { display: grid; gap: var(--s-7); }
  .cv-index { display: flex; flex-wrap: wrap; gap: var(--s-2) var(--s-5); align-content: start; }
  .cv-index .label { flex-basis: 100%; }
  .cv-index a { display: flex; gap: var(--s-4); min-height: 44px; align-items: center; color: var(--accent); text-decoration: none; }
  .cv-index a span { color: var(--text); }
  .cv-index a:hover span { text-decoration: underline; text-decoration-color: var(--accent); }
  @media (min-width: 1024px) { .cv-layout { grid-template-columns: minmax(0, 3fr) minmax(0, 9fr); gap: var(--s-8); } .cv-index { display: grid; position: sticky; top: calc(var(--header-h) + var(--s-5)); align-self: start; } }
  .cv__updated { color: var(--text-quiet); margin-top: var(--s-4); }
  .dl__todo { margin-top: var(--s-2); }
  .downloads { margin-top: var(--s-7); max-width: 760px; }
  .dl { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: var(--s-3); padding-block: var(--s-4); min-height: 72px; }
  .dl__label { font-size: var(--fs-row); font-weight: var(--fw-light); letter-spacing: var(--track-h); color: var(--heading); }
  .paper { max-width: 1120px; }
  .paper__head { padding-bottom: var(--s-6); border-bottom: 1px solid var(--line-strong); }
  .paper__name { font-size: var(--fs-h2); font-weight: var(--fw-thin); letter-spacing: var(--track-display); line-height: 1; }
  .paper__role { margin-top: var(--s-2); color: var(--text-muted); }
  .paper__contact { margin-top: var(--s-3); color: var(--text-muted); }
  .paper__contact a { color: var(--text); text-decoration-color: var(--accent); display: inline-block; padding-block: 10px; }
  .paper__status { margin-top: var(--s-3); color: var(--text-muted); }
  .paper__sec { padding-block: var(--s-8); border-bottom: 1px solid var(--line); scroll-margin-top: var(--header-h); }
  .paper__h { font-size: var(--fs-sub); font-weight: var(--fw-light); letter-spacing: var(--track-h); color: var(--heading); margin-bottom: var(--s-5); }
  .paper__rows { list-style: none; }
  .paper__item { display: grid; gap: var(--s-2) var(--grid-gap); padding-block: var(--s-5); }
  .paper__rows > .paper__item + .paper__item { border-top: 1px solid var(--line); }
  .paper__rows > .paper__item:first-child { border-top: 1px solid var(--line); }
  @media (min-width: 640px) { .paper__item { grid-template-columns: 11rem minmax(0, 1fr); } }
  /* Same date column as the home Experience rows: champagne, uppercase, small. */
  .paper__when { display: flex; flex-direction: column; gap: 2px; color: var(--accent); padding-top: 0.35em; font-size: var(--fs-cap); letter-spacing: var(--track-label); text-transform: uppercase; }
  .paper__year { color: var(--accent); }
  .paper__item h4 { font-weight: var(--fw-light); font-size: var(--fs-row); letter-spacing: var(--track-h); line-height: 1.3; color: var(--heading); }
  .paper__item h4 a { text-decoration-color: var(--accent); display: inline-block; padding-block: 11px; margin-block: -11px; }
  .paper__item p { color: var(--text-muted); margin-top: var(--s-1); }
  .paper__tags { margin-top: var(--s-2); }
</style>
