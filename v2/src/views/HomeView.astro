---
import Base from '../layouts/Base.astro';
import Hero from '../components/home/Hero.astro';
import About from '../components/home/About.astro';
import ProofStrip from '../components/home/ProofStrip.astro';
import SelectedWork from '../components/home/SelectedWork.astro';
import Experience from '../components/home/Experience.astro';
import Capabilities from '../components/home/Capabilities.astro';
import NowLab from '../components/home/NowLab.astro';
import TwoDoors from '../components/home/TwoDoors.astro';
import type { Lang } from '../i18n/ui';
import { heroPortrait, PORTRAIT_SIZES } from '../lib/portrait';
interface Props { lang: Lang }
const { lang } = Astro.props;
const meta = {
  en: {
    title: 'Mamoun El Araki · AI and software engineer',
    description: 'AI and software engineer: explainable aneurysm-risk AI (paper accepted at ICOA 2026), 90% less processing time at Intelcia, and a football xG model.',
  },
  fr: {
    title: 'Mamoun El Araki · Ingénieur IA et logiciel',
    description: 'Ingénieur IA et logiciel : IA explicable du risque d’anévrisme (ICOA 2026), 90 % de temps de traitement en moins chez Intelcia, un modèle xG.',
  },
}[lang];
const portrait = await heroPortrait();
---
<Base lang={lang} title={meta.title} description={meta.description} ogKey="home" bodyClass="page-home">
  <link slot="head" rel="preload" as="image" type="image/avif" imagesrcset={portrait.avif} imagesizes={PORTRAIT_SIZES} fetchpriority="high" />
  <Hero lang={lang} />
  <About lang={lang} />
  <ProofStrip lang={lang} />
  <SelectedWork lang={lang} />
  <Experience lang={lang} />
  <Capabilities lang={lang} />
  <NowLab lang={lang} />
  <TwoDoors lang={lang} />
</Base>
