---
import Todo from '../components/mdx/Todo.astro';
// Privacy note and the form's no-JS "sent" page.
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import { type Lang, lp, t } from '../i18n/ui';
interface Props { lang: Lang; page: 'privacy' | 'sent' }
const { lang, page } = Astro.props;
const fr = lang === 'fr';
const copy = {
  privacy: {
    title: fr ? 'Confidentialité' : 'Privacy',
    meta: fr ? 'Confidentialité · Mamoun El Araki' : 'Privacy · Mamoun El Araki',
    desc: fr ? 'Ce site ne pose aucun cookie et ne fait aucune mesure d’audience. Ce que devient le formulaire de contact.' : 'This site sets no cookies and runs no analytics. What happens to the contact form.',
    body: fr
      ? ['Ce site ne pose aucun cookie et ne fait aucune mesure d’audience.', 'Les liens EN et FR permettent de choisir la langue de la page.', 'Le terminal ask-mamoun cherche dans un fichier JSON statique, dans votre navigateur : vos questions ne sont envoyées nulle part.', 'Le formulaire transmet le sujet, votre nom, votre e-mail et votre message uniquement pour que je puisse vous répondre.']
      : ['This site sets no cookies and runs no analytics.', 'Use the EN and FR links to choose the page language.', 'The ask-mamoun terminal searches a static JSON file inside your browser: your questions are not sent anywhere.', 'The contact form sends the topic, your name, email and message only so I can reply.'],
    todo: fr ? 'nom du service de formulaire (Netlify Forms ou Formspree)' : 'name of the form service (Netlify Forms or Formspree)',
  },
  sent: {
    title: fr ? 'Message envoyé' : 'Message sent',
    meta: fr ? 'Message envoyé · Mamoun El Araki' : 'Message sent · Mamoun El Araki',
    desc: fr ? 'Votre message est bien parti.' : 'Your message is on its way.',
    body: fr ? ['Merci, votre message est bien parti.'] : ['Thanks, your message is on its way.'],
    todo: '',
  },
}[page];
---
<Base lang={lang} title={copy.meta} description={copy.desc} ogKey={page === 'sent' ? 'contact' : 'privacy'} noindex={page === 'sent'}>
  <PageIntro label={page === 'sent' ? 'Contact' : (fr ? 'Informations du site' : 'Site information')} title={copy.title}>
    <div class="simple prose">
      {copy.body.map((p) => <p>{p}</p>)}
      {copy.todo && <p><Todo>{copy.todo}</Todo></p>}
      <p><a href={lp(lang, '/')}>{t(lang, 'nav.home')} →</a></p>
    </div>
  </PageIntro>
</Base>

<style>
  .simple { margin-top: var(--s-6); color: var(--text-muted); font-size: var(--fs-lede); }
</style>
