---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import ProjectCard from '../components/ProjectCard.astro';
import MoreProjects from '../components/MoreProjects.astro';
import { person } from '../data/site';
import { type Lang } from '../i18n/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;
const fr = lang === 'fr';
const featured = (await getCollection('projects', (p) => p.data.lang === lang && p.data.tier === 'featured')).sort((a, b) => a.data.order - b.data.order);
const [first, ...rest] = featured;
---
<Base
  lang={lang}
  title={fr ? `Projets · ${person.name}` : `Work · ${person.name}`}
  description={fr
    ? 'Trois projets en détail (AneuXplain, DCE Scraper chez Intelcia, PitchPoint), chacun avec son chiffre et son point de départ, et cinq plus petits.'
    : 'Three projects in depth (AneuXplain, the Intelcia DCE Scraper, PitchPoint), each with its number and starting point, plus five smaller ones.'}
  ogKey="work"
>
  <PageIntro
    label={fr ? 'Projets' : 'Work'}
    title={fr ? 'Projets' : 'Work'}
    lede={fr
      ? 'Trois projets en détail, puis les plus petits. Chaque carte montre ce que j’ai construit, ce qui a changé et mon point de départ.'
      : 'Three projects in depth, then the smaller ones. Each card shows what I built, what changed, and what I started from.'}
    word="WORK"
  />

  <section class="section work-list" aria-label={fr ? 'Projets choisis' : 'Selected projects'}>
    <div class="wrap work-grid">
      <ProjectCard project={first} lang={lang} large headingLevel="h2" />
      {rest.map((p) => <ProjectCard project={p} lang={lang} headingLevel="h2" />)}
    </div>
  </section>

  <section class="section band" aria-label={fr ? 'Autres projets' : 'More projects'}>
    <div class="wrap">
      <MoreProjects lang={lang} heading="h2" id="work-more" />
    </div>
  </section>
</Base>

<style>
  .work-list { padding-top: 0; }
  .work-grid { display: grid; gap: var(--s-9) var(--grid-gap); }
  @media (min-width: 900px) {
    .work-grid { grid-template-columns: 1fr 1fr; align-items: start; }
    .work-grid > :global(.pcard--large) { grid-column: 1 / -1; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: var(--s-7); }
  }
</style>
