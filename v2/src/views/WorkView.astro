---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import ProjectCard from '../components/ProjectCard.astro';
import MoreProjects from '../components/MoreProjects.astro';
import { person } from '../data/site';
import { type Lang } from '../i18n/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;
const fr = lang === 'fr';
const featured = (await getCollection('projects', (p) => p.data.lang === lang && p.data.tier === 'featured')).sort((a, b) => a.data.order - b.data.order);
---
<Base
  lang={lang}
  title={fr ? `Projets · ${person.name}` : `Work · ${person.name}`}
  description={fr
    ? 'Trois projets en détail (AneuXplain, DCE Scraper chez Intelcia, PitchPoint), chacun avec son chiffre et son point de départ, et cinq plus petits.'
    : 'Three projects in depth (AneuXplain, the Intelcia DCE Scraper, PitchPoint), each with its number and starting point, plus five smaller ones.'}
  ogKey="work"
>
  <PageIntro
    label={fr ? 'Projets' : 'Work'}
    title={fr ? 'Projets' : 'Work'}
    lede={fr
      ? 'Trois projets en détail, chacun avec son chiffre, puis les plus petits.'
      : 'Three projects in depth, each with its number, then the smaller ones.'}
   
  />

  <section class="section work-list" aria-label={fr ? 'Projets choisis' : 'Selected projects'}>
    <div class="wrap work-grid">
      {featured.map((p) => <ProjectCard project={p} lang={lang} headingLevel="h2" />)}
    </div>
  </section>

  <section class="section band" aria-label={fr ? 'Autres projets' : 'More projects'}>
    <div class="wrap">
      <MoreProjects lang={lang} heading="h2" id="work-more" />
    </div>
  </section>
</Base>

<style>
  .work-grid { display: grid; }
  .work-grid > :global(.pcard) { padding-block: var(--s-8); border-top: 1px solid var(--line); }
  .work-grid > :global(.pcard:first-child) { border-top: 0; padding-top: 0; }
  @media (min-width: 1024px) {
    .work-grid > :global(.pcard) { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--grid-gap); align-items: start; }
    .work-grid > :global(.pcard) > :global(.pcard__media) { grid-column: 1 / span 7; }
    .work-grid > :global(.pcard) > :global(.pcard__body) { grid-column: 9 / -1; }
  }
</style>
