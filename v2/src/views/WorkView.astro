---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Rich from '../components/Rich.astro';
import qr from '../assets/quiz-app-qr.png';
import { archive, workFilters } from '../data/site';
import type { Lang } from '../i18n/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;
const fr = lang === 'fr';
const projects = (await getCollection('projects', (p) => p.data.lang === lang)).sort((a, b) => a.data.order - b.data.order);
const total = projects.length + archive.length;
---
<Base
  lang={lang}
  title={fr ? 'Projets · Mamoun Tantaoui El Araki' : 'Work · Mamoun Tantaoui El Araki'}
  description={fr
    ? 'Cinq études de cas (automatisation Intelcia, RAG on-premise, recherche AneuXplain, eSaha, Preparia) et les projets plus petits, chacun avec son chiffre.'
    : 'Five case studies (Intelcia automation, on-prem RAG, AneuXplain research, eSaha, Preparia) and the smaller projects around them, each with its number.'}
  ogKey="work"
>
  <PageIntro
    label={fr ? 'Projets' : 'Work'}
    title={fr ? 'Projets' : 'Work'}
    lede={fr
      ? 'Cinq études de cas et les plus petits projets autour. Chaque carte montre le chiffre que je défendrais en entretien.'
      : 'Five case studies and the smaller things around them. Every card shows the one number I’d defend in an interview.'}
    word="WORK"
  >
    <div class="filters" role="group" aria-label={fr ? 'Filtrer les projets' : 'Filter projects'} hidden data-js-show>
      {workFilters.map((f, i) => (
        <button type="button" class="filter" data-filter={f.key} aria-pressed={i === 0 ? 'true' : 'false'}>{f.label[lang]}</button>
      ))}
    </div>
    <p class="sr-only" aria-live="polite" data-filter-status data-template={fr ? '{n} projets affichés' : '{n} projects shown'}></p>
  </PageIntro>

  <section class="section work-list" aria-label={fr ? 'Études de cas' : 'Case studies'}>
    <div class="wrap work-grid">
      {projects.map((p, i) => <ProjectCard project={p} lang={lang} index={i + 1} large={i === 0} headingLevel="h2" />)}
    </div>
  </section>

  <section class="section band archive" aria-labelledby="archive-h2">
    <div class="wrap">
      <p class="label">{fr ? 'Archives' : 'Archive'}</p>
      <h2 class="h2" id="archive-h2">{fr ? 'Un quiz Kotlin et une appli de cours Flutter.' : 'A Kotlin quiz and a Flutter course app.'}</h2>
      <ul class="rows archive__rows">
        {archive.map((a) => (
          <li class="archive__row" data-categories={a.category}>
            <p class="archive__kind mono">{a.kind[lang]}</p>
            <h3 class="archive__title">{a.title}</h3>
            <Rich as="p" class="archive__text" text={a.text[lang]} />
            <div class="archive__links">
              {a.links.map((l) => <a class="btn btn--sm" href={l.href} target="_blank" rel="noopener">{l.label}<span class="sr-only"> (opens in a new tab)</span></a>)}
              {a.qr && (
                <details class="archive__qr">
                  <summary class="btn btn--sm">{fr ? 'QR de l’APK Android' : 'Android APK QR code'}</summary>
                  <Image src={qr} alt={fr ? 'QR code pour télécharger l’application Android Quiz Game' : 'QR code to download the Quiz Game Android app'} width={180} />
                </details>
              )}
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>

<style>
  .filters { display: flex; flex-wrap: wrap; gap: var(--s-2); margin-top: var(--s-6); }
  .filter {
    min-height: 44px; padding: 0 var(--s-4); border-radius: var(--r-pill); border: 1px solid var(--line-input);
    background: transparent; cursor: pointer; font-size: 0.9375rem;
  }
  .filter[aria-pressed='true'] { background: var(--text); color: var(--bg); border-color: var(--text); }
  .work-list { padding-top: 0; }
  .work-grid { display: grid; gap: var(--s-9); }
  @media (min-width: 900px) {
    .work-grid { grid-template-columns: 1fr 1fr; gap: var(--s-9) var(--s-7); align-items: start; }
    .work-grid > :global(.pcard--large) { grid-column: 1 / -1; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: var(--s-7); }
    .work-grid > :global(:nth-child(odd):not(.pcard--large)) { margin-top: var(--s-9); }
  }
  .work-grid :global([hidden]) { display: none !important; }
  .archive__rows { margin-top: var(--s-7); }
  .archive__row { display: grid; gap: var(--s-2) var(--s-6); padding-block: var(--s-6); }
  @media (min-width: 900px) { .archive__row { grid-template-columns: 12rem minmax(0, 1fr) auto; align-items: baseline; } }
  .archive__kind { color: var(--text-quiet); }
  .archive__title { font-family: var(--font-display); font-size: var(--fs-h3); font-weight: 600; letter-spacing: -0.03em; }
  .archive__text { color: var(--text-muted); max-width: 60ch; }
  @media (min-width: 900px) { .archive__text { grid-column: 2; } .archive__links { grid-column: 3; grid-row: 1 / span 2; } }
  .archive__links { display: flex; flex-wrap: wrap; gap: var(--s-2); align-items: start; }
  .archive__qr summary { list-style: none; }
  .archive__qr summary::-webkit-details-marker { display: none; }
  .archive__qr :global(img) { margin-top: var(--s-3); border-radius: 12px; background: #fff; padding: 8px; }
</style>
