---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import ProjectCard from '../components/ProjectCard.astro';
import MoreProjects from '../components/MoreProjects.astro';
import { person } from '../data/site';
import { type Lang } from '../i18n/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;
const fr = lang === 'fr';
const featured = (await getCollection('projects', (p) => p.data.lang === lang && p.data.tier === 'featured')).sort((a, b) => a.data.order - b.data.order);
---
<Base
  lang={lang}
  title={fr ? `Projets · ${person.name}` : `Work · ${person.name}`}
  description={fr
    ? 'Trois projets en détail (AneuXplain, DCE Scraper chez Intelcia, PitchPoint), chacun avec son chiffre et son point de départ, et cinq plus petits.'
    : 'Three projects in depth (AneuXplain, the Intelcia DCE Scraper, PitchPoint), each with its number and starting point, plus five smaller ones.'}
  ogKey="work"
>
  <PageIntro
    label={fr ? 'Projets' : 'Work'}
    title={fr ? 'Projets choisis.' : 'Selected projects.'}
    lede={fr
      ? 'De mon projet de fin d’études à l’automatisation chez Intelcia : ce que j’ai construit, les choix techniques et les limites.'
      : 'From my capstone to automation at Intelcia: what I built, the technical decisions and the limitations.'}
  >
    <nav class="work-index" aria-label={fr ? 'Index des projets' : 'Project index'}>
      {featured.map((p, i) => <a href={`#project-${p.data.key}`}><span class="meta">0{i + 1}</span>{p.data.title}<span aria-hidden="true">↓</span></a>)}
      <a href="#work-more">{fr ? 'Autres projets' : 'More projects'}<span aria-hidden="true">↓</span></a>
    </nav>
  </PageIntro>

  <section class="section work-list" aria-label={fr ? 'Projets choisis' : 'Selected projects'}>
    <div class="wrap work-grid">
      {featured.map((p, i) => <div class="work-entry" id={`project-${p.data.key}`}><p class="work-entry__index meta" aria-hidden="true">0{i + 1}</p><ProjectCard project={p} lang={lang} headingLevel="h2" /></div>)}
    </div>
  </section>

  <section class="section band" aria-label={fr ? 'Autres projets' : 'More projects'}>
    <div class="wrap">
      <MoreProjects lang={lang} heading="h2" id="work-more" />
    </div>
  </section>
</Base>

<style>
  .work-grid { display: grid; }
  .work-list { padding-top: var(--s-7); }
  .work-index { display: flex; flex-wrap: wrap; gap: var(--s-3) var(--s-7); margin-top: var(--s-7); border-top: 1px solid var(--line-strong); padding-top: var(--s-4); }
  .work-index a { display: inline-flex; gap: var(--s-3); align-items: center; min-height: 44px; text-decoration: none; }
  .work-index a:hover { color: var(--accent); }
  .work-index .meta { color: var(--accent); }
  .work-entry { padding-block: var(--s-7); border-top: 1px solid var(--line); scroll-margin-top: calc(var(--header-h) + var(--s-5)); }
  .work-entry:first-child { border-top: 0; padding-top: 0; }
  .work-entry__index { color: var(--accent); margin-bottom: var(--s-5); }
  @media (min-width: 1024px) {
    .work-entry > :global(.pcard) { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); column-gap: var(--s-7); align-items: center; }
    .work-entry:nth-child(2) > :global(.pcard) > :global(.pcard__media) { order: 2; }
  }
</style>
