{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/_astro/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/work/secure-gov-rag/:rest*",
      "destination": "/work",
      "permanent": true
    },
    {
      "source": "/work/secure-gov-rag",
      "destination": "/work",
      "permanent": true
    },
    {
      "source": "/work/secure-government-rag",
      "destination": "/work",
      "permanent": true
    },
    {
      "source": "/fr/work/secure-gov-rag",
      "destination": "/fr/work",
      "permanent": true
    },
    {
      "source": "/fr/work/secure-government-rag",
      "destination": "/fr/work",
      "permanent": true
    }
  ]
}
